<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OMniX.AutoUpdater.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:OMniX.AutoUpdater.Helpers"
    xmlns:local="using:OMniX.AutoUpdater"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibleConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>




        <StackPanel VerticalAlignment="Center" Visibility="{x:Bind ViewModel.InStartupView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                Margin="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="OMniX Auto Updater" />
            <TextBlock
                VerticalAlignment="Center"
                IsTextSelectionEnabled="True"
                Text="This updater downloads the latest version from GitHub and overwrites the program files."
                TextWrapping="WrapWholeWords" />
            <TextBlock
                VerticalAlignment="Center"
                IsTextSelectionEnabled="True"
                Text="Only OMniX's own files are replaced — nothing is deleted, and files you placed in the OMniX folder are left untouched."
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Margin="0,8"
                IsTextSelectionEnabled="True"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="OMniX will close during the update and reopen itself afterwards. Don't shut down your computer in the meantime."
                TextWrapping="WrapWholeWords" />

            <!--  二开：GitHub 拉不动的时候，自己去 Release 页面把 zip 下好，在这儿选上就能装  -->
            <Button
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.PickLocalPackageCommand}"
                Content="Choose local update package…"
                ToolTipService.ToolTip="Use this when downloads are too slow or GitHub is unreachable: download the zip from the Releases page yourself, then pick it here to install." />

            <!--  二开：本地导入模式 —— 不走网络，直接用用户选好的 zip  -->
            <Border
                Margin="0,12,0,0"
                Padding="12,8"
                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                CornerRadius="6"
                Visibility="{x:Bind ViewModel.IsLocalUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <!--  注意：这里不能拆成 <Run Text="{x:Bind …}"/> —— Run.Text 不支持 x:Bind，
                      编译能过，运行时 LoadComponent 直接抛 XamlParseException，更新器白屏闪退  -->
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.LocalPackageHint, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </Border>

            <Button
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.StartUpdateCommand}"
                Content="Start Update" />
        </StackPanel>



        <Grid VerticalAlignment="Top" Visibility="{x:Bind ViewModel.UpdateProcessStarted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,16,8,16"
                        HorizontalAlignment="Left"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="Updating to version" />

                    <TextBlock
                        Margin="0,16,0,16"
                        HorizontalAlignment="Left"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.LatestVersion, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1">

                    <HyperlinkButton
                        Margin="0,16,0,16"
                        HorizontalAlignment="Right"
                        NavigateUri="{x:Bind ViewModel.DefaultBrowserUri, Mode=OneWay}">
                        <HyperlinkButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,4,0" Text="Latest version" />
                                <FontIcon Glyph="&#xE8A7;" />
                            </StackPanel>
                        </HyperlinkButton.Content>
                    </HyperlinkButton>

                    <ProgressRing
                        HorizontalAlignment="Right"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        IsIndeterminate="True" />
                </StackPanel>
            </Grid>

            <controls:Segmented
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsItemClickEnabled="False"
                SelectionMode="Multiple">
                <controls:SegmentedItem
                    Content="Check for updates"
                    IsHitTestVisible="False"
                    IsSelected="{x:Bind ViewModel.UpdateProgress.CheckingForLatestUpdate, Mode=OneWay}" />
                <controls:SegmentedItem
                    Content="Download update"
                    IsHitTestVisible="False"
                    IsSelected="{x:Bind ViewModel.UpdateProgress.DownloadingLatestUpdate, Mode=OneWay}" />
                <controls:SegmentedItem
                    Content="Extract files"
                    IsHitTestVisible="False"
                    IsSelected="{x:Bind ViewModel.UpdateProgress.ExtractingLatestUpdate, Mode=OneWay}" />
                <controls:SegmentedItem
                    Content="Install OMniX"
                    IsHitTestVisible="False"
                    IsSelected="{x:Bind ViewModel.UpdateProgress.InstallingLatestUpdate, Mode=OneWay}" />
            </controls:Segmented>


            <Button
                Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.StartUpdateCancelCommand}"
                Content="Cancel" />

            <Button
                Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.StartUpdateCommand}"
                Content="Retry" />

            <Button
                Grid.Row="2"
                HorizontalAlignment="Center"
                Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                Command="{x:Bind ViewModel.StartOmniXCommand}"
                Content="Launch OMniX…"
                Visibility="{x:Bind ViewModel.FinishedSuccessfully, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />


            <InfoBar
                Grid.Row="3"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.Stopped, Mode=OneWay}"
                Message="{x:Bind ViewModel.StopReason, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.Stopped, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <ListView
                Grid.Row="4"
                Margin="0,8,0,0"
                ItemsSource="{x:Bind ViewModel.ProgressLog, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LogEntry">
                        <Grid
                            Padding="2"
                            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="2">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>


                            <TextBlock
                                HorizontalAlignment="Left"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Message, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                Grid.Row="1"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Footer, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                Grid.Row="2"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind TimeStamp, Mode=OneWay}" />

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>


        </Grid>

    </Grid>
</Page>
