<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx
    x:Class="OMniX.WinUI.Views.GbModPageWindow"
    xmlns:l="using:WinUI3Localizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OMniX.WinUI.Views.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OMniX.WinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modPageViewModels="using:OMniX.WinUI.ViewModels.ModPageViewModels"
    xmlns:services="using:OMniX.Core.Services"
    xmlns:viewModels="using:OMniX.WinUI.ViewModels"
    xmlns:winUiEx="using:WinUIEx"
    x:Name="RootWindow"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Page>
        <Page.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Page.Resources>
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="12,8,12,4" Spacing="6">
                    <!--  Mod 信息头：名称 + 网页面包屑识别  -->
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.ModName, Mode=OneWay, FallbackValue=加载中}"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.BreadcrumbText, Mode=OneWay, FallbackValue=''}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Text="{x:Bind ViewModel.DetectStatusText, Mode=OneWay, FallbackValue=''}" />
                    </StackPanel>

                    <!--  安装目标：自动识别 + 可手动更改（下拉紧贴安装路径前面）  -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            Width="170"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.InstallTargets, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedInstallTarget, Mode=TwoWay}"
                            ToolTipService.ToolTip="选择安装到哪个角色（按网页分类自动识别，识别错可在此更改）" />
                        <controls:LinkButton
                            VerticalAlignment="Center"
                            Link="{x:Bind ViewModel.CharacterModListPath, Mode=OneWay}"
                            ToolTipService.ToolTip="打开 Mod 文件夹…"
                            Text="{x:Bind ViewModel.CharacterModListPath.LocalPath, Mode=OneWay, FallbackValue=ModPath}" />
                    </StackPanel>
                </StackPanel>

                <controls1:SwitchPresenter Grid.Row="1" Value="{x:Bind ViewModel.Initializing, Mode=OneWay}">

                    <controls1:Case Value="true">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel>
                                <ProgressRing IsActive="True" />
                                <TextBlock Text="正在从 GameBanana 读取 Mod 信息…"
            l:Uids.Uid="/WindowsUi/Win_ModUpdateLoading"/>
                            </StackPanel>
                        </Grid>

                    </controls1:Case>
                    <controls1:Case Value="false">
                        <ListView
                            Margin="12,0,12,0"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.ModFileInfos, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="modPageViewModels:ModFileInfoVm">
                                    <Grid
                                        Margin="0,6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                        <controls:BoolBorder
                                            BorderColor="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                                            BorderSize="2"
                                            ShowBorder="{x:Bind IsNew}">
                                            <Grid Margin="12,10" RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!--  第一行：文件名 + 元数据 + 按钮  -->
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        IsTextSelectionEnabled="True"
                                                        Text="{x:Bind FileName}"
                                                        TextWrapping="Wrap" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind FileSizeText, FallbackValue=''}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            ToolTipService.ToolTip="{x:Bind DateAddedTooltipFormat}"
                                                            Text="{x:Bind AgeFormated}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind DownloadCountText, FallbackValue=''}" />
                                                        <Button
                                                            Command="{x:Bind DownloadCommand}"
                                                            CommandParameter="{Binding Mode=OneWay}"
                                                            Content="Download"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            Visibility="{Binding Path=ShowDownloadButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <Button
                                                            Command="{x:Bind InstallCommand}"
                                                            CommandParameter="{Binding Mode=OneWay}"
                                                            Content="Install"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            Visibility="{Binding Path=ShowInstallButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!--  第二行：描述  -->
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind Description}"
                                                    TextWrapping="Wrap" />

                                                <!--  第三行：下载进度（下载中才显示）  -->
                                                <StackPanel Grid.Row="2" Spacing="2">
                                                    <ProgressBar
                                                        Maximum="100"
                                                        Value="{x:Bind DownloadProgress, Mode=OneWay}"
                                                        Visibility="{Binding ShowDownloadButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind DownloadProgress, Mode=OneWay, FallbackValue=0}"
                                                        Visibility="{Binding ShowDownloadButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>

                                                <Grid Grid.Row="3" Height="3">
                                                    <ProgressBar
                                                        IsIndeterminate="{x:Bind IsBusy, Mode=OneWay}"
                                                        Visibility="{Binding Path=IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </Grid>
                                            </Grid>
                                        </controls:BoolBorder>
                                    </Grid>

                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </controls1:Case>

                </controls1:SwitchPresenter>



                <Grid Grid.Row="2" Margin="12,4,12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  全局下载进度（下载中才显示）：文件名 + 进度 + 百分比  -->
                    <Grid
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.DownloadingVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,10,0"
                            MaxWidth="260"
                            VerticalAlignment="Center"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.CurrentDownloadFile, Mode=OneWay, FallbackValue=''}" />
                        <ProgressBar
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Value="{x:Bind ViewModel.CurrentDownloadProgress, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind ViewModel.CurrentDownloadProgress, Mode=OneWay, FallbackValue=0}" />
                    </Grid>

                    <Button
                        Grid.Column="1"
                        Width="120"
                        Command="{x:Bind ViewModel.CloseCommand}"
                        Content="Close"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        ToolTipService.ToolTip="关闭窗口"
            l:Uids.Uid="/WindowsUi/Win_CloseWindowTip" />
                </Grid>

            </Grid>
            <Grid Grid.Column="1" Background="{ThemeResource SmokeFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                        <TextBlock
                            Margin="10,0"
                            VerticalAlignment="Center"
                            Text="Mod 页面："
            l:Uids.Uid="/WindowsUi/Win_ModPageLabel"/>
                        <controls:LinkButton
                            VerticalAlignment="Center"
                            Link="{x:Bind ViewModel.ModPage, Mode=OneWay}"
                            ToolTipService.ToolTip="用默认浏览器打开…"
            l:Uids.Uid="/WindowsUi/Win_OpenBrowserTip"
                            Text="{x:Bind ViewModel.ModPage, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Margin="8,0"
                        Click="ButtonBase_OnClick"
                        Content="Downloads"
                        IsEnabled="{x:Bind ViewModel.IsOpenDownloadButtonEnabled, Mode=OneWay}" />
                    <ProgressRing
                        x:Name="ModPageLoadingRing"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        IsActive="False" />

                </Grid>

                <Grid Grid.Row="1" Background="{ThemeResource SmokeFillColorDefaultBrush}">
                    <WebView2
                        x:Name="ModPageBrowser"
                        DefaultBackgroundColor="Transparent"
                        Source="{x:Bind ViewModel.ModPage, Mode=TwoWay}"
                        Visibility="Collapsed" />
                </Grid>

            </Grid>

            <controls1:GridSplitter
                x:Name="ModPaneSplitter"
                Grid.Column="1"
                Width="8"
                Height="40"
                HorizontalAlignment="Left"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Auto">
                <controls1:GridSplitter.RenderTransform>
                    <TranslateTransform X="-10" />
                </controls1:GridSplitter.RenderTransform>
            </controls1:GridSplitter>
        </Grid>
    </Page>

</winUiEx:WindowEx>
