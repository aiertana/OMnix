<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OMniX.WinUI.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OMniX.WinUI.Views.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:OMniX.WinUI.Helpers.Xaml"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/DataTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <xaml:BoolToVisibleConverter x:Key="BoolToVisibleConverter" />
        </ResourceDictionary>
    </Page.Resources>


    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  ===== 标题 + 跳过 =====  -->
        <Grid Margin="{StaticResource SmallTopMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    HorizontalAlignment="Left"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="首次启动配置" />

                <!--  二开：署名  -->
                <TextBlock
                    Margin="0,0,0,3"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                    Text="by 是湫" />
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Bottom"
                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.SelectedGame.GameName, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsGameSetupVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" />

            <Button
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.SkipStartupWizardCommand}"
                Content="返回首页"
                Style="{ThemeResource OmniXSoftButtonStyle}"
                ToolTipService.ToolTip="返回首页，之后可从首页的引导卡重新进入配置" />

        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">

            <Grid>

                <!--  ===== 第一步：选择游戏 =====  -->
                <StackPanel
                    Margin="0,8,0,0"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsGameSelectionVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">

                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="选择需要管理的游戏，点击图标进入该游戏的文件夹配置。以后可在“设置”页面中切换游戏。"
                        TextWrapping="WrapWholeWords" />

                    <GridView
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        IsItemClickEnabled="True"
                        ItemClick="GameCard_OnItemClick"
                        ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="150"
                                    Height="160"
                                    Padding="10"
                                    Style="{ThemeResource OmniXCardStyle}">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <Border
                                            Width="72"
                                            Height="72"
                                            Background="{ThemeResource OmniXAccentSoftBrush}"
                                            CornerRadius="20">
                                            <Image Stretch="UniformToFill">
                                                <Image.Source>
                                                    <BitmapImage
                                                        DecodePixelWidth="72"
                                                        UriSource="{Binding GameIconPath}" />
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            Text="{Binding GameName}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!--  ===== 第二步：该游戏的文件夹配置 =====  -->
                <StackPanel
                    Margin="0,8,0,0"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.IsGameSetupVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">

                    <Button
                        Command="{x:Bind ViewModel.BackToGameSelectionCommand}"
                        Content="← 重新选择游戏"
                        Style="{ThemeResource OmniXGhostButtonStyle}" />

                    <!--  Description  -->
                    <Grid Margin="{StaticResource SmallTopBottomMargin}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="选择启动器所在的文件夹即可，例如 D:\mod\XXMI Launcher。OMniX 会自动识别其中的启动程序（如 Resources\Bin\XXMI Launcher.exe）并推导 Mods 文件夹（如 WWMI\Mods）。"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                TextWrapping="WrapWholeWords"
                                Text="保存后 OMniX 会在 Mods 文件夹内为每个角色创建一个文件夹，启用/禁用 Mod 时会给 Mod 文件夹加上 'DISABLED_' 前缀。"
                                l:Uids.Uid="/Startup/Body2" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                TextWrapping="WrapWholeWords"
                                Text="使用前建议先备份你的文件/Mod"
                                l:Uids.Uid="/Startup/BackupWarning" />

                            <StackPanel Orientation="Horizontal">
                                <HyperlinkButton
                                    NavigateUri="{x:Bind ViewModel.ModelImporterUrl, Mode=OneWay}"
                                    ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=NavigateUri, Mode=OneWay}">
                                    <HyperlinkButton.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Bind ViewModel.ModelImporterName, Mode=OneWay}" />
                                        </StackPanel>
                                    </HyperlinkButton.Content>
                                </HyperlinkButton>
                                <HyperlinkButton
                                    NavigateUri="https://www.nexusmods.com/"
                                    ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=NavigateUri, Mode=OneWay}">
                                    Nexusmods
                                </HyperlinkButton>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--  启动器文件夹（原 3Dmigoto 文件夹）  -->
                    <controls:FolderSelector
                        Title="启动器文件夹"
                        Margin="4,8,4,8"
                        BrowseCommand="{x:Bind ViewModel.BrowseLauncherFolderCommand}"
                        Footer="例如：D:\mod\XXMI Launcher"
                        PathChangedEvent="LauncherFolder_OnPathChangedEvent"
                        PlaceHolderText="选择包含 XXMI Launcher.exe 等启动器程序的文件夹"
                        SelectedFolderValue="{x:Bind ViewModel.PathToGIMIFolderPicker.Path, Mode=TwoWay}"
                        ValidationErrorText="{x:Bind ViewModel.PathToGIMIFolderPicker.ValidationMessages, Mode=OneWay}" />

                    <InfoBar
                        Margin="4,0,4,8"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.LauncherExecutablePath, Mode=OneWay}"
                        Severity="Success"
                        Title="已识别到启动程序"
                        Visibility="{x:Bind ViewModel.HasLauncherExecutable, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" />

                    <!--  Mods 文件夹  -->
                    <controls:FolderSelector
                        Title="Mods 文件夹"
                        Margin="4,8,4,8"
                        BrowseCommand="{x:Bind ViewModel.BrowseModsFolderCommand}"
                        Footer="{x:Bind ViewModel.ModsFolderHint, Mode=OneWay}"
                        PathChangedEvent="ModsFolder_OnPathChangedEvent"
                        SelectedFolderValue="{x:Bind ViewModel.PathToModsFolderPicker.Path, Mode=TwoWay}"
                        ValidationErrorText="{x:Bind ViewModel.PathToModsFolderPicker.ValidationMessages, Mode=OneWay}" />

                    <Grid Margin="{StaticResource SmallTopBottomMargin}" Visibility="Collapsed">
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            TextWrapping="WrapWholeWords"
                            Text="卸载 Mod 的功能还没做。等以后做了，可以把选中的 Mod 挪到单独的卸载区文件夹里。" />
                    </Grid>
                    <controls:FolderSelector
                        Title="卸载区文件夹（可选）"
                        Margin="4,8,4,8"
                        IsEnabled="False"
                        Visibility="Collapsed" />


                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <CheckBox
                            Margin="12,0,12,0"
                            Content="重新整理 Mods"
                            IsChecked="{x:Bind ViewModel.ReorganizeModsOnStartup, Mode=TwoWay}" />

                        <Button Background="Transparent" CornerRadius="8">
                            <Button.Flyout>
                                <Flyout>
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel>

                                        <TextBlock
                                            Margin="0,8,0,4"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            TextWrapping="WrapWholeWords"
                                            Text="勾上之后，程序会把现有的 Mod 按角色分到各自的文件夹里。实在对不上角色的，会放进「Others」文件夹。"
                                            l:Uids.Uid="/Startup/ReorganizeTooltip1" />

                                        <TextBlock
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            TextWrapping="WrapWholeWords"
                                            Text="如果某个 Mod 文件夹里塞了好几个角色的名字，可能会被挪到错误角色的目录下。这套逻辑假设 Mod 是平铺存放的（皮肤文件夹直接躺在 Mods 里）。要是你自己搞了很深的嵌套结构，OMniX 认错皮肤的概率会比较高。"
                                            l:Uids.Uid="/Startup/ReorganizeTooltip2" />

                                        <TextBlock
                                            Margin="0,8,0,4"
                                            Style="{ThemeResource BaseTextBlockStyle}"
                                            TextWrapping="WrapWholeWords"
                                            Text="以后也可以在设置页里打开。"
                                            l:Uids.Uid="/Startup/ReorganizeTooltip3" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel>
                                <FontIcon FontSize="28" Glyph="&#xF142;" />
                            </StackPanel>
                        </Button>

                        <CheckBox
                            Margin="40,0,12,0"
                            Content="同时禁用全部 Mods"
                            IsChecked="{x:Bind ViewModel.DisableMods, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.ReorganizeModsOnStartup, Mode=OneWay}" />

                        <Button Background="Transparent" CornerRadius="8">
                            <Button.Flyout>
                                <Flyout>
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel>

                                        <TextBlock
                                            Margin="0,8,0,4"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            TextWrapping="WrapWholeWords"
                                            Text="给所有 Mod 文件夹加上 DISABLED_ 前缀，让它们全部失效"
                                            l:Uids.Uid="/Startup/DisableModsTooltip" />

                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel>
                                <FontIcon FontSize="28" Glyph="&#xF142;" />
                            </StackPanel>
                        </Button>



                    </StackPanel>

                    <!--  Save  -->
                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.SaveStartupSettingsCommand}"
                        Content="保存"
                        Style="{ThemeResource OmniXAccentButtonStyle}" />

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>
</Page>
