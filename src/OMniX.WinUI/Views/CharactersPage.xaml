<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OMniX.WinUI.Views.CharactersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.UI.Animations"
    xmlns:charactersViewModels="using:OMniX.WinUI.ViewModels.CharactersViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controls1="using:OMniX.WinUI.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OMniX.WinUI.Models"
    xmlns:subVms="using:OMniX.WinUI.ViewModels.SubVms"
    xmlns:xaml="using:OMniX.WinUI.Helpers.Xaml"
    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
    mc:Ignorable="d">

    <Page.Resources>
        <xaml:BoolToVisibleConverter x:Name="BoolToVisibleConverter" />
        <xaml:BoolInverterConverter x:Name="BoolInverterConverter" />
        <xaml:AttentionTypeToSymbolConverter x:Name="AttentionTypeToSymbolConverter" />
    </Page.Resources>

    <Grid Margin="0,-24,0,0" Background="Transparent">
        <Grid.Resources>
            <MenuFlyout x:Name="ImageCommandsFlyout" Opening="ImageCommandsFlyout_OnOpening">
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.PinCharacterCommand}"
                    CommandParameter="{Binding}"
                    Text="{x:Bind ViewModel.PinText, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="{x:Bind ViewModel.PinGlyph, Mode=OneWay}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CheckForUpdatesForCharacterCommand}"
                    CommandParameter="{Binding}"
                    IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}"
                    Text="检查更新" l:Uids.Uid="/Characters/CharPage_CheckUpdates">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.OpenCharacterFolderCommand}"
                    CommandParameter="{Binding}"
                    Text="打开文件夹..." l:Uids.Uid="/Characters/CharPage_OpenFolder">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8DA;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!--  二开：自定义角色头像  -->
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SetCharacterImageCommand}"
                    CommandParameter="{Binding}"
                    Text="导入角色头像…" l:Uids.Uid="/Characters/CharPage_ImportAvatar">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEB9F;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!--  二开：重命名（自定义角色改建角色配置，内置角色写本地 override）  -->
                <MenuFlyoutItem Command="{x:Bind ViewModel.RenameCharacterCommand}" Text="重命名" l:Uids.Uid="/Characters/CharPage_Rename">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!--  二开：删除自定义角色  -->
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.DeleteCharacterCommand}"
                    CommandParameter="{Binding}"
                    Text="删除角色" l:Uids.Uid="/Characters/CharPage_DeleteChar">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!--  二开：所属属性。内置角色只能看不能改（属性来自游戏数据）。  -->
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="所属属性" l:Uids.Uid="/Characters/CharPage_ElementSub">
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.SetCharacterElementCommand}"
                        CommandParameter="Fusion"
                        Text="热熔" l:Uids.Uid="/Characters/CharPage_ElementFusion">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{x:Bind ViewModel.GetElementIcon('Fusion')}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.SetCharacterElementCommand}"
                        CommandParameter="Glacio"
                        Text="冷凝" l:Uids.Uid="/Characters/CharPage_ElementGlacio">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{x:Bind ViewModel.GetElementIcon('Glacio')}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.SetCharacterElementCommand}"
                        CommandParameter="Aero"
                        Text="气动" l:Uids.Uid="/Characters/CharPage_ElementAero">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{x:Bind ViewModel.GetElementIcon('Aero')}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.SetCharacterElementCommand}"
                        CommandParameter="Electro"
                        Text="导电" l:Uids.Uid="/Characters/CharPage_ElementElectro">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{x:Bind ViewModel.GetElementIcon('Electro')}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.SetCharacterElementCommand}"
                        CommandParameter="Spectro"
                        Text="衍射" l:Uids.Uid="/Characters/CharPage_ElementSpectro">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{x:Bind ViewModel.GetElementIcon('Spectro')}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.SetCharacterElementCommand}"
                        CommandParameter="Havoc"
                        Text="湮灭" l:Uids.Uid="/Characters/CharPage_ElementHavoc">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{x:Bind ViewModel.GetElementIcon('Havoc')}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.SetCharacterElementCommand}"
                        CommandParameter="Other"
                        Text="其他（无属性）" l:Uids.Uid="/Characters/CharPage_ElementOther">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{x:Bind ViewModel.GetElementIcon('Other')}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>

                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Mods">
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.ClearNotificationsCommand}"
                        CommandParameter="{Binding}"
                        Text="清除通知" l:Uids.Uid="/Characters/CharPage_ClearNotifications">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE894;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.DisableCharacterModsCommand}"
                        CommandParameter="{Binding}"
                        Text="禁用该角色全部 Mod" l:Uids.Uid="/Characters/CharPage_DisableAllMods"/>
                </MenuFlyoutSubItem>
            </MenuFlyout>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentDialog
    x:Name="SelectProcessDialog"
    l:Uids.Uid="/Characters/CharPage_PickProcess"
    Title="选择程序路径"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.SimpleSelectProcessDialogVM.PathPicker.IsValid, Mode=OneWay}"
    PrimaryButtonText="保存"
    SecondaryButtonText="取消">
            <Grid MinWidth="500" MinHeight="200">

                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>

                    <TextBlock
                        Margin="0,0,0,8"
                        Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="WrapWholeWords"
                        Text="选择要启动的程序路径。保存后，点击启动按钮即可直接启动，可在设置页面重置。" l:Uids.Uid="/Characters/CharPage_PickProcessHint"/>

                    <controls1:FolderSelector
                        Title=""
                        BrowseCommand="{x:Bind ViewModel.SimpleSelectProcessDialogVM.BrowseSimpleCommand}"
                        PlaceHolderText="{x:Bind ViewModel.SimpleSelectProcessDialogVM.PlaceHolderText, Mode=OneWay}"
                        SelectedFolderValue="{x:Bind ViewModel.SimpleSelectProcessDialogVM.PathPicker.Path, Mode=TwoWay}"
                        ValidationErrorText="{x:Bind ViewModel.SimpleSelectProcessDialogVM.PathPicker.ValidationMessages, Mode=OneWay}" />
                </StackPanel>

                <Button
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.SimpleSelectProcessDialogVM.ShowAdvancedDialogCommand}"
                    Content="创建高级启动命令" l:Uids.Uid="/Characters/CharPage_AdvancedCmd"/>

            </Grid>
        </ContentDialog>

        <!--  ===== 页头：标题 / 统计 / 操作 =====  -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{ThemeResource OmniXPageTitleStyle}" Text="{x:Bind ViewModel.CategoryPageTitle, Mode=OneWay}" />
                <TextBlock Style="{ThemeResource OmniXCaptionStyle}" Text="{x:Bind ViewModel.OverviewStatsText, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">

                <Button Content="Mod 预设" Style="{ThemeResource OmniXSoftButtonStyle}" l:Uids.Uid="/Characters/CharPage_PresetButton">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <ScrollViewer Margin="-4">
                                <StackPanel MinWidth="300" Spacing="8">
                                    <TextBlock Style="{ThemeResource OmniXCaptionStyle}" Text="应用预设" l:Uids.Uid="/Characters/CharPage_ApplyPresetCaption"/>

                                    <!--  二开：随机 Mod 置顶  -->
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Bind ViewModel.RandomizeModsCommand}"
                                        Style="{ThemeResource OmniXGhostButtonStyle}"
                                        ToolTipService.ToolTip="随机启用 Mod" l:Uids.Uid="/Characters/CharPage_RandomizeTip">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="12" Glyph="&#xE8B1;" />
                                            <TextBlock Text="随机 Mod" l:Uids.Uid="/Characters/CharPage_RandomizeText"/>
                                        </StackPanel>
                                    </Button>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!--
                                        二开：预设名左对齐，右侧四个图标按钮（置顶 / 保存 / 重命名 / 删除）。
                                        正在用的预设名字是绿色的，置顶过的「针」是深灰色的。
                                    -->
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModPresets}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="2" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="charactersViewModels:ModPresetEntryVm">
                                                <Grid ColumnSpacing="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button
                                                        Grid.Column="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Style="{ThemeResource OmniXGhostButtonStyle}"
                                                        ToolTipService.ToolTip="点击应用这个预设" l:Uids.Uid="/Characters/CharPage_PresetApplyTip">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon
                                                                FontSize="12"
                                                                Foreground="{x:Bind NameBrush, Mode=OneWay}"
                                                                Glyph="&#xEA41;" />
                                                            <TextBlock
                                                                Foreground="{x:Bind NameBrush, Mode=OneWay}"
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button.Flyout>
                                                            <Flyout Placement="Right">
                                                                <Button Command="{x:Bind ApplyPresetCommand}" CommandParameter="{x:Bind}">
                                                                    <TextBlock Text="确认应用" l:Uids.Uid="/Characters/CharPage_PresetConfirmApply"/>
                                                                </Button>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>

                                                    <!--  二开：点一下置顶（针变实心 + 深灰），再点一下取消  -->
                                                    <Button
                                                        Grid.Column="1"
                                                        AutomationProperties.Name="置顶" l:Uids.Uid="/Characters/CharPage_PresetPin"
                                                        Command="{x:Bind PinCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        ToolTipService.ToolTip="{x:Bind PinToolTip, Mode=OneWay}">
                                                        <FontIcon
                                                            FontSize="12"
                                                            Foreground="{x:Bind PinBrush, Mode=OneWay}"
                                                            Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                                                    </Button>

                                                    <Button
                                                        Grid.Column="2"
                                                        Command="{x:Bind SaveCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        ToolTipService.ToolTip="用当前已启用的 Mod 组合覆盖这个预设" AutomationProperties.Name="保存" l:Uids.Uid="/Characters/CharPage_PresetSaveTip">
                                                        <FontIcon FontSize="12" Glyph="&#xE74E;" />
                                                    </Button>

                                                    <Button
                                                        Grid.Column="3"
                                                        Command="{x:Bind RenameCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        ToolTipService.ToolTip="给这个预设改名" AutomationProperties.Name="重命名" l:Uids.Uid="/Characters/CharPage_PresetRenameTip">
                                                        <FontIcon FontSize="12" Glyph="&#xE8AC;" />
                                                    </Button>

                                                    <Button
                                                        Grid.Column="4"
                                                        Command="{x:Bind DeleteCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        ToolTipService.ToolTip="删除这个预设" AutomationProperties.Name="删除" l:Uids.Uid="/Characters/CharPage_PresetDeleteTip">
                                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!--  二开：把当前启用状态存成预设，名字可以自己起  -->
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Bind ViewModel.SaveCurrentAsPresetCommand}"
                                        Style="{ThemeResource OmniXGhostButtonStyle}"
                                        ToolTipService.ToolTip="把当前已启用的 Mod 组合存成一个预设" l:Uids.Uid="/Characters/CharPage_SavePresetTip">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="12" Glyph="&#xE74E;" />
                                            <TextBlock Text="保存当前为预设" l:Uids.Uid="/Characters/CharPage_SavePreset"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--  二开：Mod 修复器（原「刷新」）。不再内置修复，改为下载 Moonholder/Wuwa_Mod_Fixer 最新版  -->
                <Button
                    Command="{x:Bind ViewModel.RepairModsCommand}"
                    Style="{ThemeResource OmniXGhostButtonStyle}"
                    ToolTipService.ToolTip="Mod 修复器：检查并下载最新版 Wuwa_Mod_Fixer" AutomationProperties.Name="修复" l:Uids.Uid="/Characters/CharPage_RepairTip">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid>
                            <FontIcon FontSize="12" Glyph="&#xE90F;" />
                            <!--  有新版本时冒个红点  -->
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="0,-2,-4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Fill="#FFE5484D"
                                Visibility="{x:Bind ViewModel.HasModFixerUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" />
                        </Grid>
                        <TextBlock FontSize="12" Text="修复" l:Uids.Uid="/Characters/CharPage_RepairText"/>
                    </StackPanel>
                </Button>

                <Button
                    AutomationProperties.Name="启动器" l:Uids.Uid="/Characters/CharPage_Launcher"
                    Command="{x:Bind ViewModel.Start3DmigotoCommand}"
                    Style="{ThemeResource OmniXGhostButtonStyle}">
                    <ToolTipService.ToolTip>
                        <TextBlock TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.ThreeDMigtoProcessManager.ProcessPath, Mode=OneWay}" />
                    </ToolTipService.ToolTip>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE7B8;" />
                        <TextBlock FontSize="12" Text="启动器" l:Uids.Uid="/Characters/CharPage_LauncherText"/>
                    </StackPanel>
                </Button>

                <Button
                    Command="{x:Bind ViewModel.StartGenshinCommand}"
                    Style="{ThemeResource OmniXWarmButtonStyle}">
                    <ToolTipService.ToolTip>
                        <TextBlock TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.GenshinProcessManager.ProcessPath, Mode=OneWay}" />
                    </ToolTipService.ToolTip>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="12" Text="{x:Bind ViewModel.ShortGameName, Mode=OneWay}" />
                        <Grid
                            Width="16"
                            Height="16"
                            CornerRadius="8">
                            <Image>
                                <Image.Source>
                                    <BitmapImage
                                        DecodePixelWidth="16"
                                        UriSource="{x:Bind ViewModel.StartGameIcon}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                    </StackPanel>
                </Button>


            </StackPanel>
        </Grid>

        <!--  ===== 工具条：搜索 / 元素筛选 / 显示与排序 =====  -->
        <Grid
            Grid.Row="1"
            Margin="0,16,0,10"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                Width="300"
                Margin="0"
                VerticalAlignment="Center"
                Background="#FFFFFFFF"
                CornerRadius="12"
                ItemsSource="{x:Bind ViewModel.SuggestionsBox, Mode=OneWay}"
                PlaceholderText="{x:Bind ViewModel.SearchBoxPlaceHolder, Mode=OneWay}"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_OnQuerySubmitted"
                TextChanged="AutoSuggestBox_TextChanged">
                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="F"
                        Invoked="CharacterSearchKeyShortcut"
                        Modifiers="Control" />
                </AutoSuggestBox.KeyboardAccelerators>
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:CharacterGridItemModel">
                        <StackPanel Margin="0,6" Orientation="Horizontal">
                            <Image Height="32">
                                <Image.Source>
                                    <BitmapImage
                                        DecodePixelHeight="32"
                                        UriSource="{x:Bind ImageUri, Mode=OneWay}" />
                                </Image.Source>
                            </Image>

                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource GenshinFont}"
                                FontSize="14"
                                Text="{x:Bind Character.DisplayName}" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <ScrollViewer
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Disabled"
                Visibility="{x:Bind ViewModel.DockPanelVM.IsInitialized, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                <GridView
                    MaxHeight="40"
                    VerticalAlignment="Center"
                    IsItemClickEnabled="True"
                    IsMultiSelectCheckBoxEnabled="False"
                    ItemsSource="{x:Bind ViewModel.DockPanelVM.Elements, Mode=TwoWay}"
                    SelectionChanged="Selector_OnSelectionChanged"
                    SelectionMode="Multiple">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="subVms:ElementIcon">
                            <ItemContainer
                                Width="46"
                                MaxWidth="60"
                                MaxHeight="34"
                                IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
                                ToolTipService.ToolTip="{x:Bind Name}">
                                <Grid Padding="4,0" HorizontalAlignment="Center">
                                    <Image
                                        VerticalAlignment="Center"
                                        ImageFailed="BitmapImage_OnImageFailed"
                                        Source="{x:Bind ImageUri, Mode=OneWay}" />
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </ScrollViewer>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">

                <TextBlock
                    Margin="8,0,2,0"
                    VerticalAlignment="Center"
                    Style="{ThemeResource OmniXCaptionStyle}"
                    Text="显示" l:Uids.Uid="/Characters/CharPage_ShowCaption"/>

                <ToggleButton
    Command="{x:Bind ViewModel.ShowCharactersWithModsCommand}"
    Content="有内容" l:Uids.Uid="/Characters/CharPage_HasContent"
    IsChecked="{x:Bind ViewModel.ShowOnlyCharactersWithMods, Mode=OneWay}"
    Style="{ThemeResource OmniXChipToggleStyle}"/>

                <ToggleButton
                    Command="{x:Bind ViewModel.ShowOnlyCharactersWithEnabledModsCommand}"
                    IsChecked="{x:Bind ViewModel.ShowOnlyWithEnabledMods, Mode=OneWay}"
                    Style="{ThemeResource OmniXChipToggleStyle}"
                    Content="已启用" ToolTipService.ToolTip="仅显示至少启用了一个 Mod 的对象" l:Uids.Uid="/Characters/CharPage_EnabledFilter"/>

                <ToggleButton
    Command="{x:Bind ViewModel.ShowOnlyCharactersWithModNotificationsCommand}"
    Content="有通知" l:Uids.Uid="/Characters/CharPage_HasNotifications"
    IsChecked="{x:Bind ViewModel.ShowOnlyModsWithNotifications, Mode=OneWay}"
    Style="{ThemeResource OmniXChipToggleStyle}"/>

                <TextBlock
                    Margin="12,0,2,0"
                    VerticalAlignment="Center"
                    Style="{ThemeResource OmniXCaptionStyle}"
                    Text="排序" l:Uids.Uid="/Characters/CharPage_SortCaption"/>

                <ComboBox
    x:Name="SortingComboBox"
    VerticalAlignment="Center"
    ItemsSource="{x:Bind ViewModel.SortingMethods, Mode=OneWay}"
    PlaceholderText="排序方式" l:Uids.Uid="/Characters/CharPage_SortBy"
    SelectedItem="{x:Bind ViewModel.SelectedSortingMethod, Mode=TwoWay}"
    SelectionChanged="SortingComboBox_OnSelectionChanged"
    SelectionChangedTrigger="Committed"
    Style="{ThemeResource OmniXComboBoxStyle}"/>

                <ToggleButton
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.InvertSortingCommand}"
                    IsChecked="{x:Bind ViewModel.SortByDescending, Mode=TwoWay}"
                    Style="{ThemeResource OmniXChipToggleStyle}"
                    ToolTipService.ToolTip="切换升序 / 降序" l:Uids.Uid="/Characters/CharPage_SortDirTip">
                    <FontIcon FontSize="11" Glyph="&#xE8CB;" />
                </ToggleButton>

                <!--  二开：清理同名残留（整理时被跳过的重复 Mod）  -->
                <Button
                    Padding="9,5"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.CleanDuplicateModsCommand}"
                    CornerRadius="10"
                    ToolTipService.ToolTip="清理重复 Mod 残留（删除后进回收站）" AutomationProperties.Name="清理同名残留" l:Uids.Uid="/Characters/CharPage_CleanDupTip">
                    <FontIcon FontSize="12" Glyph="&#xE74C;" />
                </Button>

                <!--  二开：回收站（清理记录 + 打开系统回收站）  -->
                <Button
                    Padding="9,5"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ShowRecycleBinCommand}"
                    CornerRadius="10"
                    ToolTipService.ToolTip="回收站：查看清理记录，打开系统回收站还原" AutomationProperties.Name="回收站" l:Uids.Uid="/Characters/CharPage_RecycleBinTip">
                    <FontIcon FontSize="12" Glyph="&#xE81C;" />
                </Button>

                <!--  二开：刷新角色列表（可整理旧分类目录 / 补充角色文件夹）  -->
                <Button
                    Padding="9,5"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.RefreshCharactersCommand}"
                    CornerRadius="10"
                    ToolTipService.ToolTip="刷新角色列表，并整理可识别的旧分类目录" AutomationProperties.Name="刷新角色列表" l:Uids.Uid="/Characters/CharPage_RefreshTip">
                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                </Button>

                <Grid MinWidth="24" Margin="4,0,0,0">
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Grid>

        <!--  ===== 角色卡片网格 =====  -->
        <Grid
            Grid.Row="2"
            Margin="0,0,0,8">
        <controls:AdaptiveGridView
            x:Name="CharactersGridView"
            animations:Connected.ListItemElementName="itemThumbnail"
            animations:Connected.ListItemKey="animationKeyContentGrid"
            animations:ItemsReorderAnimation.Duration="00:00:00.4460000"
            AllowDrop="False"
            DesiredWidth="190"
            IsItemClickEnabled="{x:Bind ViewModel.IsAddingMod, Mode=OneWay, Converter={StaticResource BoolInverterConverter}}"
            ItemClickCommand="{x:Bind ViewModel.CharacterClickedCommand}"
            ItemHeight="212"
            ItemsSource="{x:Bind ViewModel.Characters, Mode=OneWay}"
            SelectionMode="None"
            StretchContentForSingleRow="False">
            <controls:AdaptiveGridView.ItemTemplate>
                <DataTemplate x:DataType="models:CharacterGridItemModel">
                    <Grid
                        x:Name="itemThumbnail"
                        Padding="6"
                        AllowDrop="True"
                        Background="Transparent"
                        ContextFlyout="{Binding ElementName=ImageCommandsFlyout}"
                        DragEnter="CharacterThumbnail_OnDragEnter"
                        DragLeave="CharacterThumbnail_OnDragLeave"
                        Drop="CharacterThumbnail_OnDrop">

                        <!--  二开：新增角色占位卡（网格第一格）  -->
                        <Border
                            x:Name="AddCardBorder"
                            Padding="8"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            Style="{ThemeResource OmniXCardStyle}"
                            Visibility="{x:Bind IsAddCard, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Background="#FFF8FAFC"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Glyph="&#xE710;" />
                                </Border>

                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    FontFamily="{StaticResource GenshinFont}"
                                    FontSize="13"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Text="新增角色" l:Uids.Uid="/Characters/CharPage_AddCard"/>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="CharacterCardBorder"
                            Padding="8"
                            Style="{ThemeResource OmniXCardStyle}"
                            Visibility="{x:Bind IsNotAddCard, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Border Background="#FFF8FAFC" CornerRadius="10">
                                        <Image Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage
                                                    DecodePixelWidth="170"
                                                    UriSource="{x:Bind ImageUri, Mode=OneWay}" />
                                            </Image.Source>
                                        </Image>
                                    </Border>

                                    <StackPanel
                                        Margin="0,4,4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">

                                        <!--  二开：刚新建的角色，右上角标一个「新」  -->
                                        <Border
                                            Padding="6,2"
                                            Background="{ThemeResource OmniXAccentBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind IsNew, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="新" l:Uids.Uid="/Characters/CharPage_NewBadge"/>
                                        </Border>

                                        <FontIcon
                                            FontSize="11"
                                            Foreground="{ThemeResource OmniXAccentBrush}"
                                            Glyph="&#xE840;"
                                            Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" />

                                        <FontIcon
                                            FontSize="11"
                                            Foreground="{ThemeResource OmniXWarmBrush}"
                                            Glyph="{x:Bind NotificationType, Mode=OneWay, Converter={StaticResource AttentionTypeToSymbolConverter}}"
                                            Visibility="{x:Bind Notification, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" />
                                    </StackPanel>

                                    <FontIcon
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="13"
                                        Foreground="#FFFFB020"
                                        Glyph="&#xE7BA;"
                                        ToolTipService.ToolTip="启用了多个 Mod / 皮肤冲突" l:Uids.Uid="/Characters/CharPage_WarningTip"
                                        Visibility="{x:Bind Warning, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" />

                                    <Border
                                        x:Name="DropHereBorder"
                                        BorderBrush="{ThemeResource OmniXAccentBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Visibility="Collapsed" />
                                    <FontIcon
                                        x:Name="DropHereIcon"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="28"
                                        Foreground="{ThemeResource OmniXAccentBrush}"
                                        Glyph="&#xE74B;"
                                        Visibility="Collapsed" />

                                    <Border
                                        Margin="0,0,6,6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Style="{ThemeResource OmniXPillStyle}"
                                        Visibility="{x:Bind HasMods, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon
                                                FontSize="8"
                                                Foreground="{ThemeResource OmniXWarmBrush}"
                                                Glyph="&#xE735;" />
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource OmniXTextPrimaryBrush}"
                                                Text="{x:Bind ModCountString, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Margin="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Width="4"
                                        Height="4"
                                        Background="{ThemeResource OmniXAccentBrush}"
                                        CornerRadius="2"
                                        ToolTipService.ToolTip="已启用 Mod" l:Uids.Uid="/Characters/CharPage_EnabledDotTip"
                                        Visibility="{x:Bind HasEnabledMods, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" />
                                </Grid>

                                <StackPanel
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="{StaticResource GenshinFont}"
                                        FontSize="13"
                                        Foreground="{ThemeResource OmniXTextPrimaryBrush}"
                                        Text="{x:Bind Character.DisplayName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind Character.DisplayName}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </controls:AdaptiveGridView.ItemTemplate>
        </controls:AdaptiveGridView>
        </Grid>
    </Grid>
</Page>
