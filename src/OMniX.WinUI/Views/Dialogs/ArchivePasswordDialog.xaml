<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OMniX.WinUI.Views.Dialogs.ArchivePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="压缩包需要密码"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="解压"
    l:Uids.Uid="/Dialogs/ArchivePwd_Dialog"
    mc:Ignorable="d">

    <StackPanel Width="360" Spacing="10">
        <TextBlock
            x:Name="ArchiveNameText"
            Style="{ThemeResource OmniXBodyStyle}"
            TextWrapping="Wrap" />

        <TextBlock Style="{ThemeResource OmniXCaptionStyle}" Text="该压缩包已被加密，请输入解压密码后继续导入。"
                   l:Uids.Uid="/Dialogs/ArchivePwd_Hint" />

        <InfoBar
            x:Name="WrongPasswordBar"
            IsClosable="False"
            IsOpen="False"
            Message="密码不正确，请重新输入"
            Severity="Warning"
            l:Uids.Uid="/Dialogs/ArchivePwd_WrongBar" />

        <PasswordBox
            x:Name="PasswordInput"
            Header="解压密码"
            PlaceholderText="请输入密码"
            l:Uids.Uid="/Dialogs/ArchivePwd_PasswordBox"
            PasswordChanged="PasswordInput_OnPasswordChanged" />

        <CheckBox
            x:Name="ShowPasswordCheckBox"
            Checked="ShowPasswordCheckBox_OnChecked"
            Content="显示密码"
            Unchecked="ShowPasswordCheckBox_OnUnchecked"
            l:Uids.Uid="/Dialogs/ArchivePwd_ShowCheck" />
    </StackPanel>
</ContentDialog>
