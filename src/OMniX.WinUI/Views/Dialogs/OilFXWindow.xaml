<winex:WindowEx
    x:Class="OMniX.WinUI.Views.Dialogs.OilFXWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    xmlns:vm="using:OMniX.WinUI.ViewModels"
    xmlns:local="using:OMniX.WinUI.Views.Dialogs"
    mc:Ignorable="d"
    Title="OilFX 油光效果"
    Width="760"
    Height="680">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  自定义标题栏：右侧"置顶"按钮（避开系统 caption 按钮），空白区可拖动窗口  -->
        <Grid x:Name="AppTitleBar" Height="38" Background="Transparent">
            <TextBlock
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="OilFX 油光效果" />
            <Button
                x:Name="PinTopButton"
                Width="38"
                Height="30"
                Margin="0,0,132,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="PinTopButton_Click"
                ToolTipService.ToolTip="置顶窗口（游戏时不用切来切去）">
                <FontIcon x:Name="PinIcon" FontSize="13" Glyph="&#xE718;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="20,4,20,16" RowSpacing="12">
            <Grid.Resources>
        <!--  单个 mod（= 角色目录下的一个子文件夹 / 合集）行模板：开关管这个 mod 的全部 ini。
              被启动器禁用的 mod（DISABLED_ 前缀）直接列出，名字灰掉 + 「已禁用」角标 + 整行压暗  -->
        <DataTemplate x:Key="OilFxModTemplate" x:DataType="vm:OilFxRowVm">
            <StackPanel Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                <Grid
                    Padding="10,5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="{x:Bind NameBrush, Mode=OneWay}"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Padding="4,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{x:Bind DisabledBadgeBrush, Mode=OneWay}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{x:Bind DisabledBadgeVisibility, Mode=OneWay}">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{x:Bind DisabledBadgeBrush, Mode=OneWay}"
                                    Text="已禁用" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ModsSummary, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ModFolder, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Text="注入过但有 ini 缺 .bak，无法完整还原"
                            Visibility="{x:Bind NotInjectedTipVisibility, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                        OffContent=""
                        OnContent=""
                        Toggled="CharacterToggle_OnToggled" />
                    <Button
                        Grid.Column="2"
                        Padding="5"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="RestoreModButton_Click"
                        IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                        ToolTipService.ToolTip="还原这个 mod（从 .bak 恢复全部 ini）">
                        <FontIcon FontSize="14" Glyph="&#xE77B;" />
                    </Button>
                </Grid>
                <!--  注入/还原进度条：操作中显示，防卡顿误点  -->
                <ProgressBar
                    Margin="0,3,0,0"
                    Height="3"
                    Maximum="100"
                    Value="{x:Bind BusyProgress, Mode=OneWay}"
                    Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                <TextBlock
                    Margin="10,1,0,3"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind BusyText, Mode=OneWay}"
                    Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <!--  角色头像卡（小卡，一行约 9 个）：点一张进入该角色的 mod 列表  -->
        <DataTemplate x:Key="OilFxCharacterCardTemplate" x:DataType="vm:OilFxCharacterCardVm">
            <Grid
                Width="72"
                Margin="2"
                Padding="2"
                RowSpacing="2"
                ToolTipService.ToolTip="{x:Bind Summary, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Width="58"
                    Height="58"
                    CornerRadius="8">
                    <Grid>
                        <Image
                            Source="{x:Bind AvatarImage, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind HasAvatar, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind DisplayName, Mode=OneWay}"
                            Visibility="{x:Bind ShowFallbackInitial, Mode=OneWay}" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <TextBlock
                        MaxWidth="58"
                        FontSize="10"
                        Text="{x:Bind DisplayName, Mode=OneWay}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="9"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;"
                        Visibility="{x:Bind HasConflict, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ① 信息卡：框架状态 + 版本对比 + 一键安装/更新  -->
        <Border
            Grid.Row="0"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="18"
                                Foreground="{ThemeResource OmniXAccentBrush}"
                                Glyph="&#xE773;" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="OilFX 油光 / 湿身效果" />
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.FrameworkStatus, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.VersionStatus, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <HyperlinkButton
                            Content="源页面 ↗"
                            NavigateUri="{x:Bind ViewModel.SourceUrl}" />
                        <Button
                            Command="{x:Bind ViewModel.InstallOrUpdateCommand}"
                            Content="一键安装 / 更新"
                            IsEnabled="{x:Bind ViewModel.CanInstall, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
                <ProgressBar
                    Height="4"
                    IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Value="{x:Bind ViewModel.InstallProgress, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!--  ② 参数区：写进 Matcap.ini，游戏内热键仍可临时调  -->
        <Border
            Grid.Row="1"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="效果参数（写进 Matcap.ini，游戏内按热键仍可临时调）" />
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="强度" />
                    <Slider
                        Grid.Column="1"
                        Maximum="2"
                        Minimum="0"
                        StepFrequency="0.1"
                        TickFrequency="0.1"
                        TickPlacement="Outside"
                        Value="{x:Bind ViewModel.OilStrength, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        MinWidth="36"
                        Text="{x:Bind ViewModel.OilStrength, Mode=OneWay}" />
                    <ToggleSwitch
                        Grid.Column="3"
                        OffContent="风格化"
                        OnContent="写实"
                        IsOn="{x:Bind ViewModel.RealisticOil, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="款式" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        MaxWidth="220"
                        HorizontalAlignment="Left"
                        ItemsSource="{x:Bind ViewModel.SkinOptions, Mode=OneTime}"
                        SelectedIndex="{x:Bind ViewModel.OilSkin, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="游戏内 Alt+0 也可循环切换" />
                </Grid>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE7A7;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="游戏内热键（Alt+小键盘）：0 循环油光风格（0=禁用） · 1 增加强度 · 2 降低强度。注入 mod 后进游戏生效" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  ③ mod 注入：角色头像网格（点一个头像）⇄ 该角色的 mod 列表视图（每个 mod 单独开关）  -->
        <Border
            Grid.Row="2"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Margin="12,8,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="mod 注入（点角色头像，给它的 mod 单独开关油光）" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.HookStatus, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Click="ManualFolderButton_Click"
                            Content="手动选择文件夹" />
                        <Button
                            Command="{x:Bind ViewModel.RescanCommand}"
                            ToolTipService.ToolTip="刷新扫描列表">
                            <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  视图一：角色头像网格（一行约 9 个，小卡）  -->
                <GridView
                    Grid.Row="1"
                    Margin="4,2,4,4"
                    IsItemClickEnabled="True"
                    ItemsSource="{x:Bind ViewModel.CharacterCards, Mode=OneWay}"
                    ItemTemplate="{StaticResource OilFxCharacterCardTemplate}"
                    SelectionMode="Single"
                    SelectedItem="{x:Bind ViewModel.SelectedCard, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.GridVisibility, Mode=OneWay}" />

                <!--  视图二：选中角色的 mod 列表（返回按钮 + 角色名 + 冲突提示）  -->
                <Grid
                    Grid.Row="1"
                    RowDefinitions="Auto,Auto,*,Auto"
                    Visibility="{x:Bind ViewModel.ModListVisibility, Mode=OneWay}">
                    <StackPanel
                        Grid.Row="0"
                        Margin="4,0,4,2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Padding="8,3"
                            Command="{x:Bind ViewModel.BackToCharactersCommand}"
                            ToolTipService.ToolTip="返回角色网格">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="12" Glyph="&#xE76B;" />
                                <TextBlock FontSize="12" Text="返回" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            MaxWidth="380"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.SelectedCardDisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Text="{x:Bind ViewModel.SelectedConflictTip, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.SelectedConflictVisibility, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Margin="6,2,6,2"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="一个 mod 文件夹（角色目录下的子文件夹，含合集）一个开关：开 = 注入油光（自动备份 .bak），关 = 还原；灰色行 = 被启动器禁用的 mod"
                        TextWrapping="Wrap" />
                    <ListView
                        Grid.Row="2"
                        Margin="4,2,4,4"
                        ItemsSource="{x:Bind ViewModel.ModRows, Mode=OneWay}"
                        ItemTemplate="{StaticResource OilFxModTemplate}"
                        SelectionMode="None" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="12,20,12,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="这个角色目录下没有可注入的 mod"
                        Visibility="{x:Bind ViewModel.EmptyModListVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>

        <!--  ④ 底部状态  -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="单个 mod 独立开关：开 = 注入（自动备份 .bak），关 = 还原" />
            <Button
                Command="{x:Bind ViewModel.RestoreAllCommand}"
                Content="一键全部还原"
                FontSize="12" />
        </StackPanel>
        </Grid>
    </Grid>
</winex:WindowEx>
