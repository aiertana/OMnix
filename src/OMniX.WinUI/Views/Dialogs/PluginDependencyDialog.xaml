<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OMniX.WinUI.Views.Dialogs.PluginDependencyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="插件依赖检查"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="继续"
    l:Uids.Uid="/Dialogs/PluginDep_Dialog"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">660</x:Double>
    </ContentDialog.Resources>

    <StackPanel
        Width="600"
        Spacing="14">

        <TextBlock
            FontSize="12"
            Opacity="0.75"
            Text="左边那两个开关要靠下面这几样东西。缺的可以在这里补，补完再打开开关。"
            TextWrapping="Wrap"
            l:Uids.Uid="/Dialogs/PluginDep_Intro" />

        <!--  XXMI Launcher  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                x:Name="XxmiIcon"
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE783;" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="XXMI Launcher" />
                <TextBlock
                    x:Name="XxmiText"
                    FontSize="11"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                x:Name="XxmiButton"
                Grid.Column="2"
                Click="OpenXxmi_OnClick"
                Content="去下载"
                l:Uids.Uid="/Dialogs/PluginDep_XxmiBtn" />
        </Grid>

        <!--  WWMI  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                x:Name="WwmiIcon"
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE783;" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="WWMI" />
                <TextBlock
                    x:Name="WwmiText"
                    FontSize="11"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                x:Name="WwmiButton"
                Grid.Column="2"
                Click="OpenWwmi_OnClick"
                Content="说明"
                l:Uids.Uid="/Dialogs/PluginDep_WwmiBtn" />
        </Grid>

        <!--  DLSS5 部署包  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                x:Name="KitIcon"
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE783;" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="DLSS5 部署包" l:Uids.Uid="/Dialogs/PluginDep_KitTitle" />
                <TextBlock
                    x:Name="KitText"
                    FontSize="11"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                x:Name="KitButton"
                Grid.Column="2"
                Click="DownloadKit_OnClick"
                Content="自动下载"
                l:Uids.Uid="/Dialogs/PluginDep_KitBtn" />
        </Grid>

        <InfoBar
            x:Name="TipBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />

        <ProgressBar
            x:Name="DownloadBar"
            Height="3"
            IsIndeterminate="True"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
