<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OMniX.WinUI.Views.Dialogs.ModExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="using:OMniX.WinUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="导出 / 备份模组"
    CloseButtonText="关闭"
    DefaultButton="Primary"
    PrimaryButtonText="开始导出"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!--  默认 548 太窄，单选组会挤成一坨  -->
        <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
    </ContentDialog.Resources>

    <Grid
        Width="660"
        MinHeight="300"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  范围  -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource OmniXTextPrimaryBrush}"
                Text="导出范围" />

            <RadioButtons
                x:Name="ScopeRadio"
                MaxColumns="3"
                SelectedIndex="0"
                SelectionChanged="ScopeRadio_OnSelectionChanged" />
        </StackPanel>

        <!--  角色选择  -->
        <Grid
            x:Name="CharacterPanel"
            Grid.Row="1"
            Height="170"
            RowSpacing="6"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    x:Name="CharacterCountText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource OmniXTextSecondaryBrush}" />
                <Button
                    Padding="8,2"
                    Click="SelectAllCharacters_OnClick"
                    Content="全选" />
                <Button
                    Padding="8,2"
                    Click="SelectNoneCharacters_OnClick"
                    Content="全不选" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Background="{ThemeResource OmniXCardAltBackgroundBrush}"
                BorderBrush="{ThemeResource OmniXCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <ListView
                    ItemsSource="{x:Bind CharacterRows}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:CharacterExportRow">
                            <CheckBox
                                Padding="0,2"
                                Content="{x:Bind Label}"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!--  格式  -->
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource OmniXTextPrimaryBrush}"
                Text="导出格式" />
            <RadioButtons x:Name="FormatRadio" MaxColumns="2" SelectedIndex="0">
                <x:String>打包成一个 zip</x:String>
                <x:String>复制成文件夹（角色 / Mod 结构）</x:String>
            </RadioButtons>
        </StackPanel>

        <!--  保存位置  -->
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource OmniXTextPrimaryBrush}"
                Text="保存到" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="TargetBox"
                    Grid.Column="0"
                    IsSpellCheckEnabled="False" />
                <Button
                    Grid.Column="1"
                    Padding="14,6"
                    Click="Browse_OnClick"
                    Content="浏览…" />
            </Grid>
        </StackPanel>

        <!--  选项  -->
        <CheckBox
            x:Name="RemoveSettingsCheckBox"
            Grid.Row="4"
            Content="移除 OMniX 配置文件（.OMniX_ 前缀，别人用不上）"
            IsChecked="True" />

        <!--  进度  -->
        <StackPanel
            x:Name="ProgressPanel"
            Grid.Row="5"
            Spacing="6"
            Visibility="Collapsed">
            <ProgressBar x:Name="ExportBar" />
            <TextBlock
                x:Name="ProgressText"
                FontSize="11.5"
                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!--  说明  -->
        <TextBlock
            Grid.Row="6"
            FontSize="11"
            Foreground="{ThemeResource OmniXTextSecondaryBrush}"
            Text="导出只是复制，不会改动原有 Mod。zip 只打包不二次压缩，速度跟直接复制差不多。中途可以暂停或取消，取消时会把没写完的半成品删掉。"
            TextWrapping="Wrap"
            VerticalAlignment="Bottom" />
    </Grid>
</ContentDialog>
