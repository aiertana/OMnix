<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx
    x:Class="OMniX.WinUI.Views.Dialogs.GameBananaStoreWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:OMniX.WinUI.ViewModels"
    xmlns:winUiEx="using:WinUIEx"
    x:Name="RootWindow"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Page Loaded="RootPage_Loaded">
        <Page.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <!--  原版风格分类 pill：无圆点，图标+名称+(数量)，选中高亮  -->
            <ControlTemplate x:Key="StorePillTemplate" TargetType="RadioButton">
                <Border
                    x:Name="Root"
                    Padding="10,6"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CheckStates">
                            <VisualState x:Name="Checked">
                                <VisualState.Setters>
                                    <Setter Target="Root.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                    <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Unchecked" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <ContentPresenter VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Page.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  工具栏：标题 + 搜索 + 排序 + 角色 + 代理  -->
            <Grid Padding="14,10" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="GameBanana" />

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    PlaceholderText="搜索 Mod（留空看最新发布）"
                    KeyDown="SearchBox_KeyDown"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <FontIcon
                        Margin="0,0,-24,0"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8CB;" />
                    <ComboBox
                        Width="120"
                        VerticalAlignment="Center"
                        SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="默认" />
                        <ComboBoxItem Content="最近更新" />
                        <ComboBoxItem Content="最多下载" />
                        <ComboBoxItem Content="最多点赞" />
                    </ComboBox>
                </StackPanel>

                <!--  角色筛选（仿原版角色面板）：pill 行之外再给一个弹出的完整角色列表  -->
                <Button
                    x:Name="CharacterPickerButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Click="SubCategoryPicker_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.SelectedSubCategoryLabel, Mode=OneWay}" />
                        <FontIcon FontSize="10" Glyph="&#xE70D;" />
                    </StackPanel>
                </Button>

                <!--  代理设置：没开 VPN 的用户从这里配加速  -->
                <Button
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Click="ProxySettings_Click"
                    ToolTipService.ToolTip="GameBanana 访问代理"
                    Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE968;" />
                </Button>

                <Button
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="搜索" />
            </Grid>

            <!--  pill 行：全部 Mod + 全部角色 + Other/Misc + UI，横向排列（原版风格），滚轮横滚  -->
            <ListView
                Grid.Row="1"
                Margin="14,4,14,0"
                IsItemClickEnabled="True"
                ItemClick="RootCategoryList_Click"
                ItemsSource="{x:Bind ViewModel.PillItems, Mode=OneWay}"
                PointerWheelChanged="PillList_PointerWheelChanged"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!--  纯视觉 pill：点击由 ListView.ItemClick 承担，RB 关闭命中测试  -->
                        <RadioButton
                            IsChecked="{Binding IsSelected, Mode=OneWay}"
                            IsHitTestVisible="False"
                            Template="{StaticResource StorePillTemplate}">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="{Binding Icon, Mode=OneWay}"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding CountText}" />
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Popup
                x:Name="SubCategoryPopup"
                IsLightDismissEnabled="True">
                <Border
                    Width="260"
                    Height="380"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                    <StackPanel Spacing="8">
                        <TextBox
                            Header="筛选..."
                            Text="{x:Bind ViewModel.SubCategoryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ListView
                            Height="300"
                            ItemsSource="{x:Bind ViewModel.FilteredSubCategories, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="SubCategoryList_Click"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Width="18"
                                            Height="18"
                                            Source="{Binding Icon, Mode=OneWay}"
                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding CountText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Popup>

            <!--  结果网格  -->
            <ScrollView Grid.Row="3">
            <GridView
                Padding="14,0,14,10"
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="ResultCard_Click">
                <GridView.ItemTemplate>
                    <!--  窗口根的 x:Bind 在 DataTemplate 里会踩 XamlCompiler 的坑，卡片一律走 DataContext Binding  -->
                    <DataTemplate>
                        <Grid
                            Width="220"
                            Margin="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="124" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8,8,0,0">
                                <Image Source="{Binding Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>

                            <TextBlock
                                Grid.Row="1"
                                Margin="10,8,10,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />

                            <StackPanel
                                Grid.Row="2"
                                Margin="10,4,10,10"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Grid Width="22" Height="22">
                                    <!--  头像就绪前显示作者名首字母占位  -->
                                    <Border
                                        CornerRadius="11"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{Binding ShowAvatarPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding AuthorInitial}" />
                                    </Border>
                                    <Ellipse Width="22" Height="22">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AuthorAvatar, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Author}" />
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon FontSize="11" Glyph="&#xE8CF;" />
                                    <TextBlock FontSize="11" Text="{Binding Likes}" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{Binding DateText}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollView>

        <!--  底栏：状态 + 加载更多  -->
        <Grid Grid.Row="4" Padding="14,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                Visibility="{x:Bind ViewModel.LoadMoreVisibility, Mode=OneWay}"
                Content="加载更多" />
        </Grid>
        </Grid>
    </Page>
</winUiEx:WindowEx>
