<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OMniX.WinUI.Views.ModsOverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OMniX.WinUI.Views.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:OMniX.WinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OMniX.WinUI.Models"
    xmlns:viewModels="using:OMniX.WinUI.ViewModels"
    x:Name="PageRoot"
    mc:Ignorable="d">

    <Page.Resources>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--
            二开：快捷卡共用样式。四张卡以前各抄一遍同样的背景、描边、图标块，
            抽出来之后每张卡只剩颜色、字母和文案有差异。
        -->
        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="QuickActionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource OmniXCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource OmniXCardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <!--  卡顶那一条彩色细线，颜色由每张卡自己指定  -->
        <Style x:Key="QuickActionBeamStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="2" />
            <Setter Property="Margin" Value="14,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
        </Style>

        <!--  左上角的字母方块  -->
        <Style x:Key="QuickActionBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="QuickActionBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="QuickActionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QuickActionDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Flyout
            x:Key="CommandMenuFlyout"
            Opening="CommandMenuFlyout_OnOpening"
            Placement="BottomEdgeAlignedLeft"
            ShouldConstrainToRootBounds="False">
            <Grid MaxWidth="400" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="对该文件夹运行命令：" l:Uids.Uid="/ModList/ModsOv_RunCmdLabel"/>
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.OpenFolderCommand}"
                        ToolTipService.ToolTip="打开文件夹" l:Uids.Uid="/ModList/ModsOv_OpenFolderTip">
                        <FontIcon Glyph="&#xE838;" />
                    </Button>

                </Grid>
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.CommandDefinitions}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>

                        <DataTemplate x:DataType="viewModels:ModOverviewCommandVM">
                            <Grid
                                Margin="0,4,0,4"
                                Padding="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                ColumnSpacing="4"
                                CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind DisplayName}"
                                        Text="{x:Bind DisplayName}" />


                                    <StackPanel>
                                        <TextBlock IsTextSelectionEnabled="True" Text="完整命令：" l:Uids.Uid="/ModList/ModsOv_FullCmdLabel"/>
                                        <TextBlock
                                            Padding="6,0,0,0"
                                            IsTextSelectionEnabled="True"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind FullCommand}"
                                            Text="{x:Bind FullCommand}" />
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock IsTextSelectionEnabled="True" Text="工作目录：" l:Uids.Uid="/ModList/ModsOv_WorkDirLabel"/>
                                        <TextBlock
                                            Padding="6,0,0,0"
                                            IsTextSelectionEnabled="True"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind WorkingDirectory}"
                                            Text="{x:Bind WorkingDirectory}" />
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock IsTextSelectionEnabled="True" Text="'{{TargetPath}}:" />
                                        <TextBlock
                                            Padding="6,0,0,0"
                                            IsTextSelectionEnabled="True"
                                            Tag="TargetPathText"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind TargetPath, Mode=OneWay}"
                                            Text="{x:Bind TargetPath, Mode=OneWay}" />
                                    </StackPanel>


                                </StackPanel>

                                <Button
    Grid.Column="1"
    VerticalAlignment="Center"
    Command="{x:Bind RunCommand}"
    CommandParameter="{x:Bind}"
    Content="运行" l:Uids.Uid="/ModList/ModsOv_Run"
    Style="{ThemeResource AccentButtonStyle}"/>
                            </Grid>

                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

        </Flyout>


        <DataTemplate x:Key="CategoryTemplate" x:DataType="viewModels:CategoryNode">
            <TreeViewItem
                ContextFlyout="{StaticResource CommandMenuFlyout}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                ItemsSource="{x:Bind ModdableObjects}"
                Visibility="{x:Bind IsVisible, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <!--  二开：分类图标（原本这里是个空的占位 TextBlock）  -->
                    <Image
                        Width="20"
                        Height="20"
                        Margin="0,0,8,0"
                        Source="{x:Bind IconUri}"
                        Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayName}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>


        <DataTemplate x:Key="CharacterTemplate" x:DataType="viewModels:ModdableObjectNode">
            <TreeViewItem
                ContextFlyout="{StaticResource CommandMenuFlyout}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                ItemsSource="{x:Bind Mods}"
                Visibility="{x:Bind IsVisible, Mode=OneWay}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Grid CornerRadius="4">
                            <Image Width="32">
                                <Image.Source>
                                    <BitmapImage DecodePixelWidth="32" UriSource="{x:Bind ImagePath}" />
                                </Image.Source>
                            </Image>
                        </Grid>

                        <TextBlock Margin="4,0,4,0" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ModdableObject.DisplayName}" />
                    </StackPanel>

                    <!--  二开：该角色下已启用 / 总 Mod 数  -->
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ModSummaryText, Mode=OneWay}" />

                    <Button
                        x:Name="GoToCharacterButton"
                        Grid.Column="2"
                        Click="GoToCharacterButton_OnClick"
                        Content="前往角色" l:Uids.Uid="/ModList/ModsOv_GoToCharacter"/>

                </Grid>

            </TreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="ModTemplate" x:DataType="viewModels:ModModelNode">
            <TreeViewItem ContextFlyout="{StaticResource CommandMenuFlyout}" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                <Grid ColumnSpacing="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  二开：勾选框就是启用开关（勾上=启用，取消=停用）  -->
                    <CheckBox
                        Grid.Column="0"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ToggleCommand}"
                        CommandParameter="{x:Bind}"
                        IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="勾选启用，取消停用" l:Uids.Uid="/ModList/ModRow_ToggleTip" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            Text="{x:Bind Mod.Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Mod.Name}" />

                        <TextBlock
    FontSize="12"
    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
    Text="已启用" l:Uids.Uid="/ModList/ModRow_Enabled"
    Visibility="{x:Bind IsEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock
    FontSize="12"
    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    Text="未启用" l:Uids.Uid="/ModList/ModRow_Disabled"
    Visibility="{x:Bind IsDisabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!--  二开：重命名  -->
                        <Button
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RenameMod_OnClick"
                            ToolTipService.ToolTip="重命名这个 Mod" l:Uids.Uid="/ModList/ModRow_RenameTip">
                            <FontIcon FontSize="12" Glyph="&#xE70F;" />
                        </Button>
                    </StackPanel>

                    <controls:LinkButton
                        Grid.Column="2"
                        Link="{x:Bind Mod.FolderPath}"
                        ToolTipService.ToolTip="打开 Mod 文件夹" l:Uids.Uid="/ModList/ModRow_OpenFolderTip"
                        Text="{x:Bind Mod.FolderName}" />

                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Margin="0,0,4,0" Text="添加于：" l:Uids.Uid="/ModList/ModRow_AddedLabel"/>
                        <TextBlock Text="{x:Bind Mod.DateAdded}" />
                    </StackPanel>

                </Grid>

            </TreeViewItem>
        </DataTemplate>

        <local:ItemTemplateSelector
            x:Key="ItemTemplateSelector"
            CategoryTemplate="{StaticResource CategoryTemplate}"
            CharacterTemplate="{StaticResource CharacterTemplate}"
            ModTemplate="{StaticResource ModTemplate}" />

    </Page.Resources>

    <Grid RowSpacing="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶栏：面包屑 + 搜索  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                Text="OMNIX  /  Mod 总览" l:Uids.Uid="/ModList/ModsOv_Breadcrumb"/>

            <AutoSuggestBox
    x:Name="SearchBox"
    Grid.Column="1"
    MinWidth="220"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    PlaceholderText="输入后按回车搜索Mod…" l:Uids.Uid="/ModList/ModsOv_Search"
    QuerySubmitted="SearchBox_OnQuerySubmitted"/>
        </Grid>

        <!--  Hero 卡  -->
        <Border
            Grid.Row="1"
            Height="260"
            Background="{ThemeResource OmniXCardBackgroundBrush}"
            BorderBrush="{ThemeResource OmniXCardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="24">
            <Grid>

                <!--  右侧装饰：虚线圈 + 粉点 + 蓝胶囊  -->
                <Grid
                    Width="300"
                    Height="230"
                    Margin="0,0,30,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <Ellipse
                        Width="220"
                        Height="220"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.5"
                        Stroke="{ThemeResource OmniXCardStrokeBrush}"
                        StrokeDashArray="4 6"
                        StrokeThickness="1" />
                    <Ellipse
                        Width="140"
                        Height="140"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.9">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#66FFFFFF" />
                                <GradientStop Offset="1" Color="#14FFFFFF" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse
                        Width="26"
                        Height="26"
                        Margin="0,0,70,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource OmniXAuxPinkBrush}" />
                    <Border
                        Width="104"
                        Height="26"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{ThemeResource OmniXAuxBlueBrush}"
                        CornerRadius="13"
                        Opacity="0.8" />
                    <Ellipse
                        Width="7"
                        Height="7"
                        Margin="58,26,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="{ThemeResource OmniXAuxPurpleBrush}" />
                </Grid>

                <!--  左侧文案  -->
                <StackPanel
                    Margin="40,0,300,0"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <TextBlock FontSize="38" FontWeight="Bold">
                        <Run Foreground="{ThemeResource OmniXAuxPinkBrush}" Text="Mod" />
                        <Run Foreground="{ThemeResource OmniXAuxPurpleBrush}" Text=" 总览" l:Uids.Uid="/ModList/ModsOv_HeroSuffix"/>
                    </TextBlock>

                    <TextBlock
                        Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.StatText, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            Padding="12,5"
                            BorderBrush="{ThemeResource OmniXCardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                Text="批量管理" l:Uids.Uid="/ModList/ModsOv_BatchManage"/>
                        </Border>
                        <Border
                            Padding="12,5"
                            BorderBrush="{ThemeResource OmniXCardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                Text="状态监控" l:Uids.Uid="/ModList/ModsOv_StatusMonitor"/>
                        </Border>
                        <Border
                            Padding="12,5"
                            BorderBrush="{ThemeResource OmniXCardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                Text="冲突检测" l:Uids.Uid="/ModList/ModsOv_ConflictDetect"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  四个快捷卡：样式抽到页面资源里，每张卡只留颜色、字母和文案  -->
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{x:Bind ViewModel.EnablePresetCommand}"
                Style="{StaticResource QuickActionButtonStyle}">
                <Border Style="{StaticResource QuickActionCardStyle}">
                    <Grid>
                        <Rectangle
                            Fill="{ThemeResource OmniXAuxPinkBrush}"
                            Style="{StaticResource QuickActionBeamStyle}" />
                        <StackPanel
                            Padding="18,18,18,16"
                            Spacing="6">
                            <Border
                                Background="{ThemeResource OmniXAuxPinkBrush}"
                                Style="{StaticResource QuickActionBadgeStyle}">
                                <TextBlock
                                    Style="{StaticResource QuickActionBadgeTextStyle}"
                                    Text="P" />
                            </Border>
                            <TextBlock
                                Style="{StaticResource QuickActionTitleStyle}"
                                Text="启用预设" l:Uids.Uid="/ModList/ModsOv_EnablePresetTitle"/>
                            <TextBlock
                                Style="{StaticResource QuickActionDescStyle}"
                                Text="选一个预设，启用里面的 Mod" l:Uids.Uid="/ModList/ModsOv_EnablePresetDesc"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.DisableAllCommand}"
                Style="{StaticResource QuickActionButtonStyle}">
                <Border Style="{StaticResource QuickActionCardStyle}">
                    <Grid>
                        <Rectangle
                            Fill="{ThemeResource OmniXAuxPurpleBrush}"
                            Style="{StaticResource QuickActionBeamStyle}" />
                        <StackPanel
                            Padding="18,18,18,16"
                            Spacing="6">
                            <Border
                                Background="{ThemeResource OmniXAuxPurpleBrush}"
                                Style="{StaticResource QuickActionBadgeStyle}">
                                <TextBlock
                                    Style="{StaticResource QuickActionBadgeTextStyle}"
                                    Text="Z" />
                            </Border>
                            <TextBlock
                                Style="{StaticResource QuickActionTitleStyle}"
                                Text="全部禁用" l:Uids.Uid="/ModList/ModsOv_DisableAllTitle"/>
                            <TextBlock
                                Style="{StaticResource QuickActionDescStyle}"
                                Text="一键关闭所有 Mod" l:Uids.Uid="/ModList/ModsOv_DisableAllDesc"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>

            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.CheckConflictsCommand}"
                Style="{StaticResource QuickActionButtonStyle}">
                <Border Style="{StaticResource QuickActionCardStyle}">
                    <Grid>
                        <Rectangle
                            Fill="{ThemeResource OmniXAuxBlueBrush}"
                            Style="{StaticResource QuickActionBeamStyle}" />
                        <StackPanel
                            Padding="18,18,18,16"
                            Spacing="6">
                            <Border
                                Background="{ThemeResource OmniXAuxBlueBrush}"
                                Style="{StaticResource QuickActionBadgeStyle}">
                                <TextBlock
                                    Style="{StaticResource QuickActionBadgeTextStyle}"
                                    Text="D" />
                            </Border>
                            <TextBlock
                                Style="{StaticResource QuickActionTitleStyle}"
                                Text="冲突检查" l:Uids.Uid="/ModList/ModsOv_CheckConflictsTitle"/>
                            <TextBlock
                                Style="{StaticResource QuickActionDescStyle}"
                                Text="扫描同角色多开的情况" l:Uids.Uid="/ModList/ModsOv_CheckConflictsDesc"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>

            <Button
                Grid.Column="3"
                Command="{x:Bind ViewModel.RefreshListCommand}"
                Style="{StaticResource QuickActionButtonStyle}">
                <Border Style="{StaticResource QuickActionCardStyle}">
                    <Grid>
                        <Rectangle
                            Fill="{ThemeResource OmniXAccentBrush}"
                            Style="{StaticResource QuickActionBeamStyle}" />
                        <StackPanel
                            Padding="18,18,18,16"
                            Spacing="6">
                            <Border
                                Background="{ThemeResource OmniXAccentBrush}"
                                Style="{StaticResource QuickActionBadgeStyle}">
                                <TextBlock
                                    Style="{StaticResource QuickActionBadgeTextStyle}"
                                    Text="R" />
                            </Border>
                            <TextBlock
                                Style="{StaticResource QuickActionTitleStyle}"
                                Text="刷新列表" l:Uids.Uid="/ModList/ModsOv_RefreshTitle"/>
                            <TextBlock
                                Style="{StaticResource QuickActionDescStyle}"
                                Text="重新读取 Mod 目录" l:Uids.Uid="/ModList/ModsOv_RefreshDesc"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </Grid>

        <TreeView
            x:Name="OverviewTreeView"
            Grid.Row="3"
            AllowDrop="False"
            CanDrag="False"
            CanReorderItems="False"
            ItemTemplateSelector="{StaticResource ItemTemplateSelector}"
            ItemsSource="{x:Bind ViewModel.Categories}" />

    </Grid>
</Page>
