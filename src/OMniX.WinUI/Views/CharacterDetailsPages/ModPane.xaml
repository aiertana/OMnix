<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OMniX.WinUI.Views.CharacterDetailsPages.ModPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OMniX.WinUI.Views.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OMniX.WinUI.Views.CharacterDetailsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:subViewModels="using:OMniX.WinUI.ViewModels.CharacterDetailsViewModels.SubViewModels"
    xmlns:xaml="using:OMniX.WinUI.Helpers.Xaml"
    xmlns:l="using:WinUI3Localizer"
    IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <xaml:StringToUri x:Name="StringToUri" />
    </UserControl.Resources>

    <Grid
        x:Name="ModDetailsPane"
        Grid.Column="1"
        Margin="0,0,0,8"
        Padding="5,5,5,5"
        Background="{ThemeResource ControlFillColorDefaultBrush}"
        CornerRadius="10">


        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            MinWidth="200"
            MinHeight="200"
            AllowDrop="True"
            Background="{ThemeResource ControlFillColorTertiaryBrush}"
            CornerRadius="10"
            DragEnter="PaneImage_OnDragEnter"
            DragOver="PaneImage_OnDragEnter"
            Drop="PaneImage_OnDrop">
            <!--
            -->
            <!--<Image Stretch="Uniform">
                <Image.Source>
                    <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind ViewModel.ModModel.ImageUri, Mode=OneWay}" />
                </Image.Source>
            </Image>
            <Button
                Margin="0,20,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}">
            -->
            <!--
                Command="{x:Bind ViewModel.ModPaneVM.SetImageUriCommand}"
            -->
            <!--
                <FontIcon Glyph="&#xE70F;" />
            </Button>-->

            <controls:CustomImage
                x:Name="ModDetailsPaneImage"
                ButtonHorizontalAlignment="Right"
                ButtonVerticalAlignment="Top"
                ClearButtonCommand="{x:Bind ViewModel.ClearImageCommand}"
                CopyButtonCommand="{x:Bind ViewModel.CopyImageToClipboardCommand}"
                EditButtonCommand="{x:Bind ViewModel.PickImageUriCommand}"
                ImageUri="{x:Bind ViewModel.ModModel.ImageUri, Mode=OneWay}"
                IsContextMenuEnabled="True"
                PasteButtonCommand="{x:Bind ViewModel.PasteImageFromClipboardCommand}" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:EditableTextBlock
                x:Name="ModNameTextBlock"
                Margin="0,8"
                HorizontalAlignment="Stretch"
                IsEditMode="{x:Bind ViewModel.IsEditingModName, Mode=OneWay}"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                TextAlignment="Center"
                ToolTipService.ToolTip="修改 Mod 显示名称"
                l:Uids.Uid="/CharacterDetails/ModPane_ModName"
                Text="{x:Bind ViewModel.ModModel.ModDisplayName, Mode=TwoWay}" />



            <SplitButton
                Grid.Column="1"
                Command="{x:Bind ViewModel.ToggleEditingModNameCommand}"
                IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}">
                <FontIcon Glyph="&#xE70F;" />
                <SplitButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.SetModIniFileCommand}"
                            ToolTipService.ToolTip="指定 OMniX 读取该 Mod 的 .ini 文件"
                            Text="指定 Mod 的 .ini 文件"
                            l:Uids.Uid="/CharacterDetails/ModPane_SetIni"/>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.ClearSetModIniFileCommand}"
                            Icon="Clear"
                            ToolTipService.ToolTip="OMniX 将不再查找 merged.ini / Script.ini，并忽略该 Mod 的按键切换"
                            Text="忽略该 Mod 的 .ini 文件"
                            l:Uids.Uid="/CharacterDetails/ModPane_ClearIni"/>
                    </MenuFlyout>
                </SplitButton.Flyout>

            </SplitButton>
        </Grid>

        <!--  二开：Mod 链接输入框已移除（空值时会显示红色错误边框，实际没什么用）  -->
        <Border Grid.Row="2" />



        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="8">

                <!--  二开：所属角色头像  -->
                <Border
                    Padding="8"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Grid
                            Width="48"
                            Height="48"
                            CornerRadius="24"
                            ToolTipService.ToolTip="角色头像"
                            l:Uids.Uid="/CharacterDetails/ModPane_CharAvatar">
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <BitmapImage
                                        DecodePixelWidth="48"
                                        UriSource="{x:Bind ViewModel.ModModel.CharacterImageUri, Mode=OneWay}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="所属角色"
                                l:Uids.Uid="/CharacterDetails/ModPane_CharLabel"/>
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.ModModel.CharacterDisplayName, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  二开：备注  -->
                <TextBox
    MinHeight="70"
    AcceptsReturn="True"
    Header="备注"
    IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}"
    PlaceholderText="点击添加备注…"
    l:Uids.Uid="/CharacterDetails/ModPane_NotesBox"
    Text="{x:Bind ViewModel.ModModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    TextWrapping="Wrap"/>

                <controls1:SwitchPresenter Visibility="{x:Bind ViewModel.IsModLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Value="{x:Bind ViewModel.ModModel.IsKeySwapManagementEnabled, Mode=OneWay}">
                <controls1:Case Value="true">
                    <StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModModel.KeySwaps, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="subViewModels:ModPaneFieldsKeySwapVm">
                                    <Grid
                                        Margin="0,4"
                                        ColumnSpacing="8"
                                        RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  二开：变量名 / 段名  -->
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind PrimaryLabel}"
                                                    ToolTipService.ToolTip="{x:Bind SectionKey, Mode=OneWay}" />

                                                <Border
                                                    Padding="4,0"
                                                    Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind IsMenu, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Text="菜单"
                                                        l:Uids.Uid="/CharacterDetails/ModPane_KeySwapMenuBadge"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind DisplayName, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="变体："
                                                    l:Uids.Uid="/CharacterDetails/ModPane_VariationsLabel"/>
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind VariationsCount, Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  二开：键帽  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <ItemsRepeater ItemsSource="{x:Bind ForwardKeyTokens, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border
                                                            Padding="8,3"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                            <TextBlock FontSize="12" Text="{x:Bind}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="/"
                                                Visibility="{x:Bind HasBackwardKey, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <ItemsRepeater ItemsSource="{x:Bind BackwardKeyTokens, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border
                                                            Padding="8,3"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                            <TextBlock FontSize="12" Text="{x:Bind}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>

                                        <!--  二开：编辑原始按键  -->
                                        <Button
                                            Grid.Column="2"
                                            Padding="6"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="EditKeys_OnClick"
                                            ToolTipService.ToolTip="编辑按键原始值"
                                            l:Uids.Uid="/CharacterDetails/ModPane_EditKeys">
                                            <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                        </Button>

                                        <!--  二开：编辑时展开原始输入框  -->
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Visibility="{x:Bind IsEditingKeys, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBox
    MinWidth="180"
    Header="前进键"
    l:Uids.Uid="/CharacterDetails/ModPane_ForwardKey"
    Text="{x:Bind ForwardHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox
    MinWidth="180"
    Header="后退键"
    l:Uids.Uid="/CharacterDetails/ModPane_BackwardKey"
    Text="{x:Bind BackwardHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                    </StackPanel>
                </controls1:Case>

                <controls1:Case Value="false">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        TextWrapping="WrapWholeWords"
                        Text="该 Mod 的按键切换管理已关闭"
                        l:Uids.Uid="/CharacterDetails/ModPane_KeySwapDisabled"/>

                </controls1:Case>
            </controls1:SwitchPresenter>

            </StackPanel>
        </ScrollViewer>


        <Grid Grid.Row="4" Padding="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Background="{ThemeResource SystemFillColorAttentionBrush}"
                Command="{x:Bind ViewModel.SaveModSettingsCommand}"
                IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Margin="0,0,4,0" Glyph="&#xE74E;" />
                        <TextBlock Text="保存" l:Uids.Uid="/CharacterDetails/ModPane_SaveButtonText"/>
                    </StackPanel>
                </Button.Content>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </Button.KeyboardAccelerators>

            </Button>

            <Grid Grid.Column="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  二开：直接在这里启用 / 停用当前 Mod  -->
                <ToggleSwitch
                    Grid.Column="1"
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.ModModel.IsEnabled, Mode=OneWay}"
                    OffContent="未启用"
                    OnContent="已启用"
                    l:Uids.Uid="/CharacterDetails/ModPane_EnabledToggle"
                    Toggled="ModEnabledToggle_OnToggled" />

            </Grid>


            <Button
    Grid.Column="2"
    HorizontalAlignment="Right"
    Command="{x:Bind ViewModel.OpenModFolderCommand}"
    Content="打开 Mod 文件夹…"
    l:Uids.Uid="/CharacterDetails/ModPane_OpenFolder"
    IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}"/>

            <!--  二开：删除（移到回收站，二次确认）  -->
            <Button
                Grid.Column="3"
                Margin="8,0,0,0"
                HorizontalAlignment="Right"
                Click="DeleteMod_OnClick"
                IsEnabled="{x:Bind ViewModel.IsNotReadOnly, Mode=OneWay}"
                ToolTipService.ToolTip="把 Mod 文件夹移到回收站，可随时还原"
                l:Uids.Uid="/CharacterDetails/ModPane_DeleteButton">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Margin="0,0,4,0" FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock Text="删除" l:Uids.Uid="/CharacterDetails/ModPane_DeleteButtonText"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
