<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OMniX.WinUI.Views.CharacterDetailsPages.CharacterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OMniX.WinUI.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OMniX.WinUI.Views.CharacterDetailsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsEnabled="{x:Bind ViewModel.IsModObjectLoaded, Mode=OneWay}"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource OmniXCardBackgroundBrush}">

        <Grid.Resources>
            <Flyout x:Name="SelectInGameSkin">
                <controls:SelectCharacterFromGrid GridSource="{x:Bind ViewModel.SelectableInGameSkins, Mode=OneWay}" ItemClickedCommand="{x:Bind ViewModel.SelectSkinCommand}" />
            </Flyout>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>
        <StackPanel MaxWidth="220">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button AutomationProperties.AcceleratorKey="Escape" Command="{x:Bind ViewModel.GoBackToGridCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" IsEnabled="True" />
                    </Button.KeyboardAccelerators>

                    <FontIcon Glyph="&#xE72B; &#xE80A; " />
                </Button>


                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="20">
                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.GoToModsOverviewCommand}"
                        ToolTipService.ToolTip="在 Mod 总览中定位">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA37;" />
                    </Button>


                    <Button
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.GoToCharacterEditScreenCommand}"
                        ToolTipService.ToolTip="编辑角色">
                        <FontIcon Glyph="&#xE70F;" />
                    </Button>
                </StackPanel>

            </Grid>

            <Grid
                x:Name="itemHero"
                Width="200"
                Height="200"
                Margin="{StaticResource SmallRightMargin}"
                Padding="{StaticResource XSmallLeftTopRightBottomMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="10">
                <Image HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Image.Source>
                        <BitmapImage DecodePixelHeight="300" UriSource="{x:Bind ViewModel.ShownModImageUri, Mode=OneWay}" />
                    </Image.Source>

                </Image>
            </Grid>
            <TextBlock
                Padding="{StaticResource XSmallLeftTopRightBottomMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontFamily="{StaticResource GenshinFont}"
                FontSize="28"
                IsTextSelectionEnabled="True"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.Below="itemHero"
                TextWrapping="Wrap"
                Text="{x:Bind ViewModel.ShownModObject.DisplayName}" />


            <StackPanel
                Margin="0,8"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                    Style="{ThemeResource BodyTextStyle}"
                    Text="已收录 Mod" />
                <TextBlock
                    Style="{ThemeResource BodyTextStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource OmniXAccentBrush}"
                    Text="{x:Bind ViewModel.TrackedModsCount, Mode=OneWay}" />
            </StackPanel>


            <StackPanel
                x:Name="selectSkinBox"
                Padding="10"
                Background="{ThemeResource OmniXCardAltBackgroundBrush}"
                CornerRadius="10"
                Visibility="{x:Bind ViewModel.IsCharacter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    Padding="0,0,0,10"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                    Text="当前游戏内皮肤" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource GenshinFont}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="WrapWholeWords"
                    Text="{x:Bind ViewModel.SelectedSkin.DisplayName, Mode=OneWay, FallbackValue=Default}" />
                <Button
                    x:Name="SelectSkinButtonElement"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    Content="选择皮肤"
                    Flyout="{StaticResource SelectInGameSkin}"
                    IsEnabled="{x:Bind ViewModel.CanChangeInGameSkins, Mode=OneWay}"
                    Style="{StaticResource OmniXSoftButtonStyle}">

                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </Button.KeyboardAccelerators>
                </Button>

                <!--  二开：只有一个皮肤时显示这行灰字，比一个点不动的灰按钮清楚  -->
                <TextBlock
                    x:Name="NoMoreSkinsTextBlock"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                    Text="暂无其他皮肤"
                    TextAlignment="Center"
                    Visibility="Collapsed" />
            </StackPanel>



        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.DisableAllModsCommand}"
                Content="禁用全部 Mod"
                Style="{StaticResource OmniXGhostButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
