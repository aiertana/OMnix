<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx
    x:Class="OMniX.WinUI.Views.Overlay.ModSwitchPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:OMniX.WinUI.Helpers.Xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winUiEx="using:WinUIEx"
    mc:Ignorable="d">

    <!--  最外层：背景图铺满，上面盖一层半透明白保证文字可读  -->
    <Grid x:Name="LayoutRoot">
        <Grid.Resources>
            <conv:BoolToObjectConverter x:Key="TabBackgroundConverter">
                <conv:BoolToObjectConverter.TrueValue>
                    <SolidColorBrush Color="#FFF3B8C4" />
                </conv:BoolToObjectConverter.TrueValue>
                <conv:BoolToObjectConverter.FalseValue>
                    <SolidColorBrush Color="#CCFFFFFF" />
                </conv:BoolToObjectConverter.FalseValue>
            </conv:BoolToObjectConverter>

            <conv:BoolToObjectConverter x:Key="CardBorderConverter">
                <conv:BoolToObjectConverter.TrueValue>
                    <SolidColorBrush Color="#FFF08C9E" />
                </conv:BoolToObjectConverter.TrueValue>
                <conv:BoolToObjectConverter.FalseValue>
                    <SolidColorBrush Color="#33000000" />
                </conv:BoolToObjectConverter.FalseValue>
            </conv:BoolToObjectConverter>

            <conv:BoolToObjectConverter x:Key="ChipOnBackgroundConverter">
                <conv:BoolToObjectConverter.TrueValue>
                    <SolidColorBrush Color="#FFF3B8C4" />
                </conv:BoolToObjectConverter.TrueValue>
                <conv:BoolToObjectConverter.FalseValue>
                    <SolidColorBrush Color="#CCFFFFFF" />
                </conv:BoolToObjectConverter.FalseValue>
            </conv:BoolToObjectConverter>

            <conv:BoolToObjectConverter x:Key="EnabledTextConverter">
                <conv:BoolToObjectConverter.TrueValue>
                    <SolidColorBrush Color="#FFE0446A" />
                </conv:BoolToObjectConverter.TrueValue>
                <conv:BoolToObjectConverter.FalseValue>
                    <SolidColorBrush Color="#EE333333" />
                </conv:BoolToObjectConverter.FalseValue>
            </conv:BoolToObjectConverter>

            <conv:BoolToObjectConverter x:Key="BoolToVisibilityConverter">
                <conv:BoolToObjectConverter.TrueValue>
                    <Visibility>Visible</Visibility>
                </conv:BoolToObjectConverter.TrueValue>
                <conv:BoolToObjectConverter.FalseValue>
                    <Visibility>Collapsed</Visibility>
                </conv:BoolToObjectConverter.FalseValue>
            </conv:BoolToObjectConverter>

            <conv:BoolToObjectConverter x:Key="BoolToVisibilityInverseConverter">
                <conv:BoolToObjectConverter.TrueValue>
                    <Visibility>Collapsed</Visibility>
                </conv:BoolToObjectConverter.TrueValue>
                <conv:BoolToObjectConverter.FalseValue>
                    <Visibility>Visible</Visibility>
                </conv:BoolToObjectConverter.FalseValue>
            </conv:BoolToObjectConverter>

            <helpers:IntEqualsToBrushConverter x:Key="SortHighlightConverter">
                <helpers:IntEqualsToBrushConverter.TrueValue>
                    <SolidColorBrush Color="#FFF3B8C4" />
                </helpers:IntEqualsToBrushConverter.TrueValue>
                <helpers:IntEqualsToBrushConverter.FalseValue>
                    <SolidColorBrush Color="#CCFFFFFF" />
                </helpers:IntEqualsToBrushConverter.FalseValue>
            </helpers:IntEqualsToBrushConverter>

            <Style x:Key="ChipButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#CCFFFFFF" />
                <Setter Property="BorderBrush" Value="#22000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#CCFFFFFF" />
                <Setter Property="BorderBrush" Value="#22000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </Grid.Resources>

        <!--  背景图：Uniform 完整显示不裁切，白纱轻一点保证看得到背景  -->
        <Image x:Name="BackgroundImage" Stretch="Uniform" />
        <Border Background="#66FFFFFF" />

        <!--  内容层：整体缩放（A- / A+），RenderTransform 放大；
              尺寸由 code-behind 按 窗口大小/scale 设置，保证 * 行能撑开  -->
        <Grid x:Name="ScaledRoot" Padding="12" RowSpacing="8">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ContentScale" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  顶栏：标题 | A- 百分比 A+ | 图钉 刷新 关闭 —— 拖这里可以移动窗口  -->
            <Grid Grid.Row="0" ColumnSpacing="8" Background="Transparent"
                  PointerPressed="WindowDrag_OnPointerPressed"
                  PointerMoved="WindowDrag_OnPointerMoved"
                  PointerReleased="WindowDrag_OnPointerReleased">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="18" Glyph="&#xE7FC;" />
                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Mod 切换" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding GameName}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                    <Button Command="{Binding ZoomOutCommand}" Content="A-" FontSize="12" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="缩小界面" />
                    <Border
                        Width="44" Height="34"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#CCFFFFFF" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="{Binding UiScaleText}" />
                    </Border>
                    <Button Command="{Binding ZoomInCommand}" Content="A+" FontSize="12" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="放大界面" />
                    <Button x:Name="PinButton" Click="PinButton_OnClick" Content="&#xE718;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="取消置顶" />
                    <Button Click="CloseButton_OnClick" Content="&#xE8BB;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!--  角色标签行：单行横向排列，滚轮 / 按住拖动横向滑动看其他角色  -->
            <ScrollViewer
                x:Name="CharacterRow"
                Grid.Row="1"
                Background="Transparent"
                MaxHeight="36"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <ItemsControl x:Name="CharacterTabsList" ItemsSource="{Binding CharacterTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="{Binding IsSelected, Converter={StaticResource TabBackgroundConverter}}"
                                BorderBrush="#22000000" BorderThickness="1"
                                CornerRadius="14" Padding="10,4" Tag="{Binding}"
                                Tapped="Tab_OnTapped">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!--  头像和角色管理页同源，圆形裁切  -->
                                    <Border
                                        Width="22" Height="22"
                                        VerticalAlignment="Center"
                                        BorderBrush="#22000000" BorderThickness="1"
                                        CornerRadius="11">
                                        <Image Source="{Binding IconUri}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Name}" />
                                    <TextBlock FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{Binding CountText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  排序 + 功能行  -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="排序:" />
                    <Button Background="{Binding SortMode, Converter={StaticResource SortHighlightConverter}, ConverterParameter=1}"
                            Click="SortName_OnClick" Content="名称" Style="{StaticResource ChipButtonStyle}" />
                    <Button Background="{Binding SortMode, Converter={StaticResource SortHighlightConverter}, ConverterParameter=2}"
                            Click="SortStatus_OnClick" Content="状态" Style="{StaticResource ChipButtonStyle}" />
                    <Button Background="{Binding SortMode, Converter={StaticResource SortHighlightConverter}, ConverterParameter=3}"
                            Click="SortTime_OnClick" Content="时间" Style="{StaticResource ChipButtonStyle}"
                            ToolTipService.ToolTip="最近改动的排前面" />
                    <Button Background="{Binding SortMode, Converter={StaticResource SortHighlightConverter}, ConverterParameter=0}"
                            Click="SortCustom_OnClick" Content="自定义" Style="{StaticResource ChipButtonStyle}"
                            ToolTipService.ToolTip="按 Mod 文件夹内部顺序" />
                    <Button Background="{Binding IsSingleSelect, Converter={StaticResource ChipOnBackgroundConverter}}"
                            Command="{Binding ToggleSingleSelectCommand}" Content="&#xE919; 单选" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                            Style="{StaticResource ChipButtonStyle}"
                            ToolTipService.ToolTip="单选模式：启用一个时自动停用同角色其它 Mod" />
                    <Button Background="{Binding IsListView, Converter={StaticResource ChipOnBackgroundConverter}}"
                            Command="{Binding ToggleListViewCommand}" Content="&#xE8FD; 列表" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                            Style="{StaticResource ChipButtonStyle}"
                            ToolTipService.ToolTip="在大封面卡片和紧凑列表之间切换" />
                </StackPanel>
            </ScrollViewer>

            <!--  Mod 内容：大封面卡片 / 紧凑列表  -->
            <Grid Grid.Row="3">
                <GridView ItemsSource="{Binding Mods}" SelectionMode="None"
                          Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibilityInverseConverter}}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid ItemWidth="316" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Background="#F2FFFFFF"
                                BorderBrush="{Binding IsEnabled, Converter={StaticResource CardBorderConverter}}"
                                BorderThickness="2" CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Image Height="180" Source="{Binding ImagePath}" Stretch="UniformToFill" />
                                        <!--  橡皮擦：停用该 Mod 恢复原版  -->
                                        <Button
                                            Width="34" Height="34"
                                            Margin="0,0,8,8"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Background="#B3FFFFFF" BorderThickness="0" CornerRadius="17"
                                            Command="{Binding DataContext.EraseModCommand, ElementName=ScaledRoot}"
                                            CommandParameter="{Binding}"
                                            Content="&#xE75C;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13"
                                            ToolTipService.ToolTip="停用该 Mod，恢复原版" />
                                    </Grid>
                                    <Grid Height="44" Padding="10,0">
                                        <TextBlock VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{Binding IsEnabled, Converter={StaticResource EnabledTextConverter}}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <ToggleSwitch MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      IsOn="{Binding IsEnabled, Mode=OneWay}"
                                                      OffContent="" OnContent="" Toggled="ModToggle_OnToggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <ListView ItemsSource="{Binding Mods}" SelectionMode="None"
                          Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="56" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="8" BorderBrush="#22000000" BorderThickness="1">
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{Binding IsEnabled, Converter={StaticResource EnabledTextConverter}}"
                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <ToggleSwitch Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                                              IsOn="{Binding IsEnabled, Mode=OneWay}"
                                              OffContent="" OnContent="" Toggled="ModToggle_OnToggled" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!--  预设行  -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6">
                <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE8B7;" />
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="预设:" />
                <ItemsControl ItemsSource="{Binding PresetNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ApplyPresetCommand, ElementName=ScaledRoot}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding}" Style="{StaticResource ChipButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  状态栏（空白处也能拖窗口）  -->
            <Grid Grid.Row="5" ColumnSpacing="8" Background="Transparent"
                  PointerPressed="WindowDrag_OnPointerPressed"
                  PointerMoved="WindowDrag_OnPointerMoved"
                  PointerReleased="WindowDrag_OnPointerReleased">
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                    <!--  游戏提权而 OMniX 没提权时才出现的救场按钮：弹 UAC 重启成管理员  -->
                    <Button
                        Command="{Binding RestartAsAdminCommand}"
                        Content="&#xE7EF; 以管理员重启"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Style="{StaticResource ChipButtonStyle}"
                        Visibility="{Binding NeedsAdminRestart, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTipService.ToolTip="以管理员身份重启 OMniX（在 UAC 弹窗点「是」），重启后浮动窗点刷新即可生效" />
                    <!--  刷新游戏内 Mod：模拟按一次 F10，切完 Mod 不用切出游戏  -->
                    <Button
                        Command="{Binding RefreshGameModsCommand}"
                        Content="&#xE72C;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="刷新游戏内 Mod（等同按 F10，游戏提权运行时需 OMniX 也提权）" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</winUiEx:WindowEx>
