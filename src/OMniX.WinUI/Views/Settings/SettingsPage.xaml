<Page
    x:Class="OMniX.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OMniX.WinUI.Views.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI.UI"
    xmlns:viewModels="using:OMniX.WinUI.ViewModels"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    xmlns:xaml1="using:OMniX.WinUI.Helpers.Xaml"
    mc:Ignorable="d">

    <Page.Resources>
        <xaml1:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <xaml1:BoolToVisibleConverter x:Key="BoolToVisibleConverter" />

        <!--  ===== 二开：统一卡片外观  =====  -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        <Style x:Key="CardDescStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  导出对话框（不占布局）  -->
        <ContentDialog
            x:Name="ExportDialog"
            Grid.RowSpan="2"
            l:Uids.Uid="Settings_ExportDialogButtons">
            <ContentDialog.ContentTemplate>
                <DataTemplate x:DataType="viewModels:ExportModsDialogModel">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords"
                            Text="这会把 OMniX 管理的所有 Mod 导出到你选择的文件夹。导出是复制操作，不会删除原有 Mod。"
                            l:Uids.Uid="Settings_ExportDialog" />

                        <StackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            ToolTipService.ToolTip="保持 OMniX 的目录结构，例如：角色/某个皮肤 Mod">
                            <CheckBox IsChecked="{x:Bind KeepFolderStructure, Mode=TwoWay}" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                TextWrapping="WrapWholeWords"
                                Text="导出时保持「角色名/Mods」的目录结构"
                                l:Uids.Uid="Settings_ExportDialog_KeepStructure" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            ToolTipService.ToolTip="此操作会递归删除所有以 .JASM_ 开头的文件和文件夹">
                            <CheckBox IsChecked="{x:Bind RemoveOmniXSettings, Mode=TwoWay}" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="从导出的 Mod 中移除 OMniX 配置文件"
                                l:Uids.Uid="Settings_ExportDialog_RemoveOmniX" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="3"
                            Orientation="Horizontal"
                            ToolTipService.ToolTip="为导出的 Mod 添加或移除「DISABLED_」前缀">
                            <ComboBox ItemsSource="{x:Bind SetModStatuses, Mode=TwoWay}" SelectedItem="{x:Bind SetModStatus, Mode=TwoWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                IsTextSelectionEnabled="True"
                                Text="修改导出 Mod 的启用状态"
                                l:Uids.Uid="Settings_ExportDialog_ChangeStatus" />
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ContentDialog.ContentTemplate>
        </ContentDialog>

        <!--  ===== 页头  =====  -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" l:Uids.Uid="Settings_Title" />
                <Border
                    Padding="10,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    CornerRadius="10">
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}" />
                </Border>
            </StackPanel>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.OpenAppFolderCommand}"
                ToolTipService.ToolTip="打开 OMniX 所在的文件夹">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock Text="程序目录" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="880"
                Margin="0,4,0,32"
                HorizontalAlignment="Left">

                <!--  ===== 外观  =====  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="外观" />

                <!--  二开：界面风格（简易版 / 标准版），只切动效，配色不变  -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="界面风格" />
                            <TextBlock
                                Style="{StaticResource CardDescStyle}"
                                Text="配色两种风格一样，差的是动效：标准版有流动光斑、悬停抬起和按压反馈，简易版是静态玻璃"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <RadioButton
                                Command="{x:Bind ViewModel.SwitchStyleCommand}"
                                CommandParameter="Standard"
                                Content="标准版"
                                GroupName="AppStyle"
                                IsChecked="{x:Bind ViewModel.IsStandardStyle, Mode=OneWay}" />
                            <RadioButton
                                Command="{x:Bind ViewModel.SwitchStyleCommand}"
                                CommandParameter="Simple"
                                Content="简易版"
                                GroupName="AppStyle"
                                IsChecked="{x:Bind ViewModel.IsSimpleStyle, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  二开：两套配色。改的是画刷实例，不用重启，整界面立刻换色  -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="配色" />
                            <TextBlock
                                Style="{StaticResource CardDescStyle}"
                                Text="两套色系，和明暗模式是两回事：暖白珊瑚是 1.0 版那套，冷调蓝是冷白底配蓝色主色"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <RadioButton
                                Command="{x:Bind ViewModel.SwitchPaletteCommand}"
                                CommandParameter="Warm"
                                Content="暖白珊瑚"
                                GroupName="AppPalette"
                                IsChecked="{x:Bind ViewModel.IsWarmPalette, Mode=OneWay}" />
                            <RadioButton
                                Command="{x:Bind ViewModel.SwitchPaletteCommand}"
                                CommandParameter="Blue"
                                Content="冷调蓝"
                                GroupName="AppPalette"
                                IsChecked="{x:Bind ViewModel.IsBluePalette, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="交互音效" />
                            <TextBlock
                                Style="{StaticResource CardDescStyle}"
                                Text="点击按钮和卡片时播放一声轻响。切到简易版会自动静音"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="1"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.SoundEnabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="窗口" />
                            <TextBlock Style="{StaticResource CardDescStyle}" Text="记住上次退出时的窗口状态，下次打开直接还原" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <CheckBox
                                Command="{x:Bind ViewModel.WindowSizePositionToggleCommand}"
                                CommandParameter="size"
                                Content="大小"
                                IsChecked="{x:Bind ViewModel.PersistWindowSize, Mode=OneWay}"
                                ToolTipService.ToolTip="勾选后，退出 OMniX 时会记住窗口大小" />
                            <CheckBox
                                Command="{x:Bind ViewModel.WindowSizePositionToggleCommand}"
                                CommandParameter="position"
                                Content="位置"
                                IsChecked="{x:Bind ViewModel.PersistWindowPosition, Mode=OneWay}"
                                ToolTipService.ToolTip="勾选后，退出 OMniX 时会记住窗口位置" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ===== 游戏与路径  =====  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="游戏与路径" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="游戏" l:Uids.Uid="/Settings/GameSelectorSectionHeader" />
                            <TextBlock
                                Style="{StaticResource CardDescStyle}"
                                Text="OMniX 目前支持《鸣潮》(Wuthering Waves)，每个游戏的设置分开保存"
                                l:Uids.Uid="/Settings/GameSelectorTitle" />
                        </StackPanel>

                        <ComboBox
                            x:Name="GameSelectorComboBox"
                            Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Bind ViewModel.Games}"
                            SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                            SelectionChanged="GameSelectorComboBox_OnSelectionChanged"
                            l:Uids.Uid="/Settings/GameSelectorComboBox" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="界面语言" l:Uids.Uid="/Settings/LanguageSelectionSectionHeader" />
                            <TextBlock
                                Style="{StaticResource CardDescStyle}"
                                Text="目前可用的语言有限，功能仍在完善中"
                                l:Uids.Uid="/Settings/LanguageSelectorTitle" />
                        </StackPanel>

                        <ComboBox
                            x:Name="LanguageSelectorComboBox"
                            Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Bind ViewModel.Languages, Mode=TwoWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                            SelectionChanged="LanguageSelectorComboBox_OnSelectionChanged"
                            l:Uids.Uid="/Settings/LanguageSelectorComboBox" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <controls:FolderSelector
                        BrowseCommand="{x:Bind ViewModel.BrowseGimiFolderCommand}"
                        PathChangedEvent="GimiFolder_OnPathChangedEvent"
                        SelectedFolderValue="{x:Bind ViewModel.PathToGIMIFolderPicker.Path, Mode=TwoWay}"
                        Title="启动器文件夹"
                        ValidationErrorText="{x:Bind ViewModel.PathToGIMIFolderPicker.ValidationMessages, Mode=OneWay}"
                        l:Uids.Uid="/Settings/3dmigotoFolderSelector" />
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="8">
                        <controls:FolderSelector
                            BrowseCommand="{x:Bind ViewModel.BrowseModsFolderCommand}"
                            PathChangedEvent="ModsFolder_OnPathChangedEvent"
                            SelectedFolderValue="{x:Bind ViewModel.PathToModsFolderPicker.Path, Mode=TwoWay}"
                            Title="Mods 文件夹"
                            ValidationErrorText="{x:Bind ViewModel.PathToModsFolderPicker.ValidationMessages, Mode=OneWay}"
                            l:Uids.Uid="/Settings/ModsFolderSelector" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.OpenModsFolderCommand}" ToolTipService.ToolTip="在资源管理器里打开 Mods 文件夹">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                                    <TextBlock Text="打开 Mods 文件夹" />
                                </StackPanel>
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.SaveSettingsCommand}"
                                Content="保存路径"
                                ToolTipService.ToolTip="更新文件夹路径" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  二开：插件保存位置。原来写死在 C 盘，C 盘紧张的用户挪不走  -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="8">
                        <controls:FolderSelector
                            BrowseCommand="{x:Bind ViewModel.BrowsePluginsFolderCommand}"
                            PathChangedEvent="PluginsFolder_OnPathChangedEvent"
                            SelectedFolderValue="{x:Bind ViewModel.PathToPluginsFolderPicker.Path, Mode=TwoWay}"
                            Title="插件文件夹"
                            ValidationErrorText="{x:Bind ViewModel.PathToPluginsFolderPicker.ValidationMessages, Mode=OneWay}" />

                        <TextBlock
                            Style="{StaticResource CardDescStyle}"
                            Text="XXMI、DLSS5 部署包、Mod 修复器下载后存放的位置。默认在 C 盘，空间紧张可以改到别的盘，改完点下面的「保存路径」。"
                            TextWrapping="WrapWholeWords" />

                        <Button
                            Command="{x:Bind ViewModel.SaveSettingsCommand}"
                            Content="保存路径"
                            ToolTipService.ToolTip="保存后会重新启动应用" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="皮肤当作独立角色" />
                            <TextBlock Style="{StaticResource CardDescStyle}" Text="开启后，一个角色的每个皮肤会单独列在角色墙里，而不是折叠在角色详情里" />
                        </StackPanel>

                        <CheckBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ToggleCharacterSkinsAsCharactersCommand}"
                            Content="启用"
                            IsChecked="{x:Bind ViewModel.CharacterAsSkinsCheckbox, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="路径重置" />
                            <TextBlock Style="{StaticResource CardDescStyle}" Text="启动器或游戏程序换了位置时，把记下的路径清掉，下次会重新让程序自己找" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Command="{x:Bind ViewModel.Reset3DmigotoPathCommand}" Content="重置启动器路径">
                                <ToolTipService.ToolTip>
                                    <TextBlock TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.ThreeDMigtoProcessManager.ProcessPath, Mode=OneWay}" />
                                </ToolTipService.ToolTip>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ResetGenshinExePathCommand}" Content="重置游戏程序路径">
                                <ToolTipService.ToolTip>
                                    <TextBlock TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.GenshinProcessManager.ProcessPath, Mode=OneWay}" />
                                </ToolTipService.ToolTip>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ===== Mod 管理  =====  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Mod 管理" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="批量操作" />
                            <TextBlock Style="{StaticResource CardDescStyle}" Text="整理、清理、批量禁用，作用范围都是当前的 Mods 文件夹" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ReorganizeModsCommand}" Content="重新整理 Mod" />
                            <Button Command="{x:Bind ViewModel.ShowCleanModsFolderDialogCommand}" Content="清理空文件夹" />
                            <Button Command="{x:Bind ViewModel.ShowDisableAllModsDialogCommand}" Content="禁用全部 Mod" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="下载缓存" />
                                <TextBlock
                                    Style="{StaticResource CardDescStyle}"
                                    Text="用 OMniX 下载 Mod 时会顺手存一份压缩包。这里限制它最多占多少空间，超出的会在启动时自动清掉" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="8">
                                <controls:LinkButton Link="{x:Bind ViewModel.ArchiveCacheFolderPath}" Text="打开缓存目录" />
                                <Button Command="{x:Bind ViewModel.ClearModCacheCommand}" Content="清空缓存" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Slider
                                x:Name="LocalCacheSlider"
                                Width="260"
                                VerticalAlignment="Center"
                                ValueChanged="LocalCacheSlider_OnValueChanged"
                                Value="{x:Bind ViewModel.MaxCacheLimit, Mode=OneWay}" />

                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.MaxCacheSizeString, Mode=OneWay}" />

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CardDescStyle}">
                                <Run Text="当前占用 " />
                                <Run Text="{x:Bind ViewModel.ModCacheSizeGB, Mode=OneWay}" />
                                <Run Text=" GB" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ===== 自动化  =====  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="自动化" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Mod 更新检查" l:Uids.Uid="/Settings/ModUpdateCheckerSectionHeader" />
                                <TextBlock
                                    Style="{StaticResource CardDescStyle}"
                                    Text="启动时和后台定期检查，只查超过 1 小时没查过的 Mod；手动检查不受这个限制"
                                    l:Uids.Uid="/Settings/ModUpdateCheckerDescription" />
                            </StackPanel>

                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.ToggleModUpdateCheckerCommand}"
                                Content="自动检查"
                                IsChecked="{x:Bind ViewModel.IsModUpdateCheckerEnabled, Mode=OneWay}"
                                l:Uids.Uid="/Settings/ModUpdateCheckerCheckBox" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource CardDescStyle}" Text="当前状态" />
                                <Border
                                    Padding="8,1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ModCheckerStatus, Mode=OneWay}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource CardDescStyle}" Text="下次检查" l:Uids.Uid="/Settings/ModUpdateCheckerNextText" />
                                <TextBlock VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.NextModCheckTime, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="提权进程" l:Uids.Uid="/Settings/ElevatorSectionHeader" />
                            <TextBlock Style="{StaticResource CardDescStyle}" Text="游戏内刷新 Mod 需要一个以管理员权限运行的辅助进程" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlAltFillColorDisabledBrush}"
                                CornerRadius="8">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ElevatorService.ElevatorStatus, Mode=OneWay}" />
                            </Border>
                            <Button
                                Command="{x:Bind ViewModel.StartElevatorCommand}"
                                Content="启动"
                                l:Uids.Uid="/Settings/StartElevatorButton" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ===== 扩展  =====  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="扩展" />

                <controls1:SettingsCard
                    Margin="0,0,0,6"
                    Command="{x:Bind ViewModel.NavigateToCommandsSettingsCommand}"
                    Description="可以定义命令（脚本），并对指定的 Mod 执行"
                    Header="自定义命令"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE716;}"
                    IsClickEnabled="True" />

                <!--  ===== 备份  =====  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="备份" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="导出 / 备份模组" />
                            <TextBlock Style="{StaticResource CardDescStyle}" Text="按角色或全量把 Mod 打包成 zip、或复制成文件夹。导出过程中可以随时暂停、取消，不会改动原有 Mod" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                AutomationProperties.Name="打开导出面板"
                                Command="{x:Bind ViewModel.OpenModExportPanelCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="打开导出面板" />
                                    <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xEDE1;" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="默认保存到程序目录下的 OMniX Exports" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ===== 关于  =====  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="关于" l:Uids.Uid="Settings_About" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource CardDescStyle}"
                                Text="让大量 Mod 的管理变得简单"
                                l:Uids.Uid="Settings_AboutDescription" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="作者：" />
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="是湫" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="GitHub：" />
                                <HyperlinkButton
                                    MinHeight="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Content="github.com/aiertana/OMnix"
                                    FontSize="12"
                                    NavigateUri="https://github.com/aiertana/OMnix" />
                            </StackPanel>
                        </StackPanel>

                        <!--  二开：手动检查更新。后台每两小时会自己查一次，但用户想主动确认时总得有地方点  -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button AutomationProperties.Name="检查更新" Command="{x:Bind ViewModel.CheckUpdateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE895;" />
                                    <TextBlock VerticalAlignment="Center" Text="检查更新" />
                                </StackPanel>
                            </Button>

                            <ProgressRing
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay}" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.UpdateCheckMessage, Mode=OneWay}" />

                            <!--  二开：网络下不动时，自己下载 zip 回来在这儿装  -->
                            <Button AutomationProperties.Name="导入本地更新包" Command="{x:Bind ViewModel.ImportLocalUpdateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE8B5;" />
                                    <TextBlock VerticalAlignment="Center" Text="导入本地更新包" />
                                </StackPanel>
                            </Button>

                            <ProgressRing
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsImportingUpdate, Mode=OneWay}" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ImportMessage, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowNewVersionAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE896;" />
                            <TextBlock VerticalAlignment="Center" Text="有新版本：" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.LatestVersion, Mode=OneWay}" />

                            <!--  二开：这次是补丁还是新版本  -->
                            <Border
                                Padding="8,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.UpdateKindText, Mode=OneWay}" />
                            </Border>

                            <controls:LinkButton Link="https://github.com/aiertana/OMnix/releases/latest" Text="看看更新了什么" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowNewVersionAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <Button VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout ShouldConstrainToRootBounds="False">
                                        <StackPanel Spacing="8">
                                            <TextBlock TextWrapping="WrapWholeWords" Text="OMniX 会退出，由自带的更新器下载新版本、自动替换文件，完成后自己重新打开。这期间别关机。" />
                                            <Button Command="{x:Bind ViewModel.UpdateOmniXCommand}" Content="是，自动更新并重启" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" Text="更新到" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.LatestVersion, Mode=OneWay}" />
                                    <FontIcon VerticalAlignment="Center" Glyph="&#xE896;" />
                                </StackPanel>
                            </Button>

                            <Button
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.IgnoreNewVersionCommand}"
                                Content="忽略这次"
                                Visibility="{x:Bind ViewModel.ShowNewVersionAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
