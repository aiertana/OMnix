<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OMniX.WinUI.Views.Settings.CreateCommandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controls2="using:OMniX.WinUI.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:OMniX.WinUI.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <StackPanel Margin="0,0,0,16">
            <TextBlock FontSize="18" Text="新建命令" l:Uids.Uid="/SettingsUi/CreateCmdTitle"/>
            <TextBox
                MinWidth="300"
                HorizontalAlignment="Left"
                Header="* 命令名称："
                PlaceholderText="显示给你看的名字（必填）"
                Text="{x:Bind ViewModel.CommandDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                l:Uids.Uid="/SettingsUi/CreateCmdNameBox"/>
        </StackPanel>



        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <controls:Segmented
                HorizontalAlignment="Center"
                SelectedIndex="0"
                SelectionMode="Single">
                <controls:SegmentedItem Content="单条命令" l:Uids.Uid="/SettingsUi/CreateCmdSingle"/>
                <controls:SegmentedItem
                    Content="命令链"
                    IsEnabled="False"
                    ToolTipService.ToolTip="还没做"
                    l:Uids.Uid="/SettingsUi/CreateCmdChain"/>
            </controls:Segmented>


            <controls1:SwitchPresenter Grid.Row="1" Value="Custom Command">
                <controls1:Case Value="Custom Command">
                    <ScrollViewer>

                        <StackPanel Spacing="8">
                            <controls2:FolderSelector
                                Title="* 程序"
                                BrowseCommand="{x:Bind ViewModel.SelectExecutableCommand}"
                                PlaceHolderText="可以直接写程序名（要求在 PATH 里），也可以填完整路径（必填）"
                                SelectedFolderValue="{x:Bind ViewModel.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                l:Uids.Uid="/SettingsUi/CreateCmdExecutable"/>

                            <controls2:FolderSelector
                                Title="工作目录"
                                BrowseCommand="{x:Bind ViewModel.SelectWorkingDirectoryCommand}"
                                Footer="{x:Bind ViewModel.EffectiveWorkingDirectory, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanEditWorkingDirectory, Mode=OneWay}"
                                PlaceHolderText="手动填路径时，文件夹必须已经存在"
                                SelectedFolderValue="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                l:Uids.Uid="/SettingsUi/CreateCmdWorkingDir"/>

                            <StackPanel>
                                <TextBox
                                    Header="启动参数"
                                    PlaceholderText="传给这个程序的参数"
                                    Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    l:Uids.Uid="/SettingsUi/CreateCmdArguments"/>
                                <TextBlock IsTextSelectionEnabled="True" Text="当命令是对着某个文件/文件夹跑的时候（比如某个 Mod 目录），{{TargetPath}} 会被换成实际路径。" l:Uids.Uid="/SettingsUi/CreateCmdTargetPathHint"/>
                            </StackPanel>


                            <StackPanel>
                                <CheckBox
                                    Content="OMniX 退出时一并结束进程"
                                    IsChecked="{x:Bind ViewModel.KillProcessOnMainAppExit, Mode=TwoWay}"
                                    ToolTipService.ToolTip="勾上之后，OMniX 关掉时这个进程也会被结束"
                                    l:Uids.Uid="/SettingsUi/CreateCmdKillOnExit"/>
                                <CheckBox
                                    Command="{x:Bind ViewModel.ToggleRunAsAdminCommand}"
                                    Content="以管理员身份运行"
                                    IsChecked="{x:Bind ViewModel.RunAsAdmin, Mode=TwoWay}"
                                    ToolTipService.ToolTip="用管理员权限启动这个程序"
                                    l:Uids.Uid="/SettingsUi/CreateCmdRunAsAdmin"/>
                                <CheckBox
                                    Command="{x:Bind ViewModel.ToggleUseShellExecuteCommand}"
                                    Content="交给系统启动"
                                    IsChecked="{x:Bind ViewModel.UseShellExecute, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanToggleUseShellExecute, Mode=OneWay}"
                                    ToolTipService.ToolTip="交给操作系统去拉起程序（ShellExecute）"
                                    l:Uids.Uid="/SettingsUi/CreateCmdUseShell"/>
                                <CheckBox
                                    Content="开新窗口"
                                    IsChecked="{x:Bind ViewModel.CreateWindow, Mode=TwoWay}"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="勾上会在单独的窗口里跑（暂不可用）"
                                    l:Uids.Uid="/SettingsUi/CreateCmdNewWindow"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                </controls1:Case>
            </controls1:SwitchPresenter>

        </Grid>

        <StackPanel Grid.Row="2" Spacing="16">
            <TextBox
                Header="最终会执行的命令："
                IsReadOnly="True"
                Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}"
                l:Uids.Uid="/SettingsUi/CreateCmdPreview"/>
            <Button
                Command="{x:Bind ViewModel.CreateCommandCommand}"
                Content="保存命令"
                Style="{ThemeResource AccentButtonStyle}"
                l:Uids.Uid="/SettingsUi/CreateCmdSave"/>
        </StackPanel>


    </Grid>
</UserControl>
