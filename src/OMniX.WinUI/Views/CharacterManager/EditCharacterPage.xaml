<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OMniX.WinUI.Views.CharacterManager.EditCharacterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:characterManagerViewModels="using:OMniX.WinUI.ViewModels.CharacterManagerViewModels"
    xmlns:controls="using:OMniX.WinUI.Views.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OMniX.WinUI.Views.CharacterManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:OMniX.WinUI.ViewModels"
    x:Name="EditCharacterPageRoot"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  二开：就地改名时用，控制「文字 / 输入框」切换  -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid
        x:Name="EditCharacterPageGrid"
        Padding="4"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        CornerRadius="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Mod 文件夹路径：" />
                <controls:LinkButton
                    Link="{x:Bind ViewModel.ModFolderUri, Mode=TwoWay}"
                    ToolTipService.ToolTip="打开这个角色的 Mod 文件夹"
                    Text="{x:Bind ViewModel.ModFolderString, Mode=TwoWay}" />

                <Button Margin="8,0,0,0" Command="{x:Bind ViewModel.GoToCharacterCommand}">查看角色</Button>
            </StackPanel>


            <Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.DisableCharacterCommand, Mode=OneWay}"
                Content="禁用角色"
                IsEnabled="{x:Bind ViewModel.CharacterStatus.IsEnabledAndNotCustomCharacter, Mode=OneWay}"
                ToolTipService.ToolTip="会先弹窗确认"
                Visibility="{x:Bind ViewModel.CharacterStatus.IsEnabledAndNotCustomCharacter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.EnableCharacterCommand, Mode=OneWay}"
                Content="启用角色"
                IsEnabled="{x:Bind ViewModel.CharacterStatus.IsDisabledAndNotCustomCharacter, Mode=OneWay}"
                ToolTipService.ToolTip="会先弹窗确认"
                Visibility="{x:Bind ViewModel.CharacterStatus.IsDisabledAndNotCustomCharacter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.DeleteCustomCharacterCommand, Mode=OneWay}"
                Content="删除自定义角色"
                IsEnabled="{x:Bind ViewModel.CharacterStatus.IsCustomCharacter, Mode=OneWay}"
                ToolTipService.ToolTip="会先弹窗确认"
                Visibility="{x:Bind ViewModel.CharacterStatus.IsCustomCharacter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />



        </Grid>

        <!--  二开：重新排版成「左表单 / 中内容 / 右按钮」三栏，Mod 列表不再被挤成一条  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  ============ 左：立绘与字段 ============  -->
            <StackPanel
                Grid.Column="0"
                Width="340"
                VerticalAlignment="Top"
                Spacing="8">

                <local:InputWrapper InputField="{x:Bind ViewModel.Form.Image}">
                    <local:InputWrapper.Input>
                        <controls:CustomImage
                            Width="330"
                            Height="220"
                            HorizontalAlignment="Left"
                            ButtonHorizontalAlignment="Left"
                            ClearButtonCommand="{x:Bind ViewModel.ClearImageCommand}"
                            CopyButtonVisibility="Collapsed"
                            EditButtonCommand="{x:Bind ViewModel.PickImageCommand}"
                            ImageUri="{x:Bind ViewModel.Form.Image.Value, Mode=TwoWay}"
                            IsContextMenuEnabled="True"
                            PasteButtonCommand="{x:Bind ViewModel.PasteImageCommand}" />
                    </local:InputWrapper.Input>
                </local:InputWrapper>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock Text="内部名（ID）：" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.Form.InternalName.Value}" />
                    </StackPanel>

                    <Button Content="?">
                        <Button.Flyout>
                            <Flyout>
                                <TextBlock
                                    MaxWidth="300"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="WrapWholeWords">
                                    内部名是 OMniX 用来识别角色 / 对象用的，同时也会被当作 Mod 文件夹的名字，不能重复。
                                    角色创建之后再改这个值，OMniX 会把它当成一个新角色。
                                </TextBlock>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <local:InputWrapper InputField="{x:Bind ViewModel.Form.DisplayName}">
                    <local:InputWrapper.Input>
                        <TextBox
                            MinWidth="200"
                            Header="显示名称"
                            PlaceholderText="{x:Bind ViewModel.Form.DisplayName.PlaceHolderText, Mode=OneWay}"
                            Text="{x:Bind ViewModel.Form.DisplayName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </local:InputWrapper.Input>
                </local:InputWrapper>

                <local:InputWrapper InputField="{x:Bind ViewModel.Form.IsMultiMod}">
                    <local:InputWrapper.Input>
                        <CheckBox Content="允许多个 Mod 同时启用" IsChecked="{x:Bind ViewModel.Form.IsMultiMod.Value, Mode=TwoWay}" />
                    </local:InputWrapper.Input>

                    <local:InputWrapper.HelpInfo>
                        <TextBlock IsTextSelectionEnabled="True" TextWrapping="WrapWholeWords">
                            勾上之后，这个角色同时启用多个 Mod 时 OMniX 不再弹警告。
                        </TextBlock>
                    </local:InputWrapper.HelpInfo>
                </local:InputWrapper>

            </StackPanel>

            <!--  ============ 中：Mod 列表 + 搜索关键字 ============  -->
            <Grid
                Grid.Column="1"
                Margin="12,0"
                RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Mod 列表  -->
                <Border
                    Grid.Row="0"
                    Padding="10"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Margin="0,0,0,6"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Mod 总数：" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.ModsCount, Mode=OneWay}" />
                        </StackPanel>

                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.Mods}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="characterManagerViewModels:ModModel">
                                    <Grid
                                        Padding="8,2"
                                        ColumnSpacing="4"
                                        CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  二开：平时显示文字（已启用绿色、未启用灰色），点「重命名」就地变成输入框，不弹窗  -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                                                <!--  二开：点这个圆点直接启用 / 禁用，启用后变绿色  -->
                                                <Border
                                                    Width="16"
                                                    Height="16"
                                                    Background="Transparent"
                                                    Tapped="ModDot_Tapped"
                                                    ToolTipService.ToolTip="{x:Bind DotToolTip, Mode=OneWay}">
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind NameBrush, Mode=OneWay}" />
                                                </Border>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{x:Bind NameBrush, Mode=OneWay}"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" />
                                            </StackPanel>

                                            <TextBox
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                KeyDown="ModRenameBox_KeyDown"
                                                Loaded="ModRenameBox_Loaded"
                                                LostFocus="ModRenameBox_LostFocus"
                                                Text="{x:Bind EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>

                                        <!--  二开：修复。用 Wuwa_Mod_Fixer 打开这个 Mod，MOD 目录会自动填好  -->
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="修复"
                                            Command="{x:Bind RepairCommand}"
                                            CommandParameter="{x:Bind}"
                                            ToolTipService.ToolTip="用修复器打开这个 Mod（MOD 目录自动填入）">
                                            <FontIcon FontSize="12" Glyph="&#xE90F;" />
                                        </Button>

                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.Name="重命名"
                                            Click="ModRename_Click"
                                            ToolTipService.ToolTip="重命名（点一下就能在上面直接改）">
                                            <FontIcon FontSize="12" Glyph="&#xE8AC;" />
                                        </Button>

                                        <Button
                                            Grid.Column="3"
                                            AutomationProperties.Name="打开文件夹"
                                            Command="{x:Bind OpenFolderCommand}"
                                            CommandParameter="{x:Bind}"
                                            ToolTipService.ToolTip="打开这个 Mod 的文件夹">
                                            <FontIcon FontSize="12" Glyph="&#xE838;" />
                                        </Button>

                                        <Button
                                            Grid.Column="4"
                                            AutomationProperties.Name="删除"
                                            Command="{x:Bind DeleteCommand}"
                                            CommandParameter="{x:Bind}"
                                            ToolTipService.ToolTip="从磁盘删除这个 Mod">
                                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                        </Button>

                                        <TextBlock
                                            Grid.Column="5"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            ToolTipService.ToolTip="添加到 OMniX 的时间"
                                            Text="{x:Bind DateAdded}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!--  搜索关键字（只占中间一栏底部，不再铺满右边）  -->
                <Border
                    Grid.Row="1"
                    Padding="10"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="搜索关键字" />

                            <TextBox
                                Grid.Column="1"
                                MinWidth="120"
                                PlaceholderText="新关键字…"
                                Text="{x:Bind ViewModel.KeyToAddInput, Mode=TwoWay}" />

                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.AddKeyCommand}"
                                Content="添加关键字" />

                            <Button
                                Grid.Column="3"
                                Content="?">
                                <Button.Flyout>
                                    <Flyout>
                                        <Grid MaxWidth="220">
                                            <TextBlock
                                                IsTextSelectionEnabled="True"
                                                TextWrapping="WrapWholeWords"
                                                Text="OMniX 用关键字来提升搜索命中率。有些角色有多个名字或俗称，都可以加成关键字。" />
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            MaxHeight="150"
                            ItemsSource="{x:Bind ViewModel.Form.Keys.Items}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="6,2" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            IsTextSelectionEnabled="True"
                                            Text="{Binding Mode=OneTime}" />
                                        <Button
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Command="{Binding ElementName=EditCharacterPageRoot, Path=ViewModel.RemoveKeyCommand, Mode=OneTime}"
                                            CommandParameter="{Binding Mode=OneTime}"
                                            Content="移除" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>
                        <local:InputWrapper Grid.Row="1" InputField="{x:Bind ViewModel.Form.Keys}" />
                    </Grid>
                </Border>
            </Grid>

            <!--  ============ 右：操作按钮 ============  -->
            <StackPanel
                Grid.Column="2"
                Width="150"
                VerticalAlignment="Top"
                Spacing="8">
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.RevertChangesCommand}"
                    Content="撤销修改"
                    ToolTipService.ToolTip="放弃还没保存的修改" />

                <Button
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Command="{x:Bind ViewModel.DummySaveCommand}"
                    Content="保存修改"
                    ToolTipService.ToolTip="把修改写入磁盘">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <Button Command="{x:Bind ViewModel.SaveChangesCommand}" Content="保存" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ShowCharacterModelCommand}">
                    <Button.Content>
                        <TextBlock TextWrapping="WrapWholeWords" Text="查看角色数据…" />
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            VerticalAlignment="Bottom">
            <Button
                Width="200"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Content="重置角色"
                ToolTipService.ToolTip="把角色数据恢复成默认值"
                Visibility="{x:Bind ViewModel.IsNotCustomCharacter, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button.Flyout>
                    <Flyout>
                        <Button Command="{x:Bind ViewModel.ResetCharacterToDefaultCommand}" Content="重置为默认值" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

    </Grid>
</Page>
