<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OMniX.WinUI.Views.FeatureAreaPage"
    xmlns:l="using:WinUI3Localizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fx="using:OMniX.WinUI.Helpers.Xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OMniX.WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            Padding="34,26,34,40"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ===== 专区头部 =====  -->
            <Border Grid.Row="0" Style="{ThemeResource OmniXGlassCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="54"
                        Height="54"
                        Background="{ThemeResource OmniXAccentBrush}"
                        CornerRadius="16">
                        <FontIcon
                            FontSize="24"
                            Foreground="White"
                            Glyph="&#xE9F0;" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <TextBlock
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource OmniXTextPrimaryBrush}"
                            Text="功能专区"
            l:Uids.Uid="/HomePreset/Feature_PageTitle"/>
                        <TextBlock
    FontSize="12"
    Foreground="{ThemeResource OmniXTextSecondaryBrush}"
    Text="插件独立于管理器：删掉插件文件不影响 Mod 管理和游戏启动，出问题也只影响它自己。"
    l:Uids.Uid="/HomePreset/Feature_PageDescription"
    TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button
    Grid.Column="2"
    Height="36"
    Padding="16,0"
    VerticalAlignment="Center"
    Command="{Binding OpenPluginsFolderCommand}"
    Content="打开插件文件夹"
    l:Uids.Uid="/HomePreset/Feature_OpenFolderButton"
    Style="{ThemeResource OmniXGhostButtonStyle}"/>
                </Grid>
            </Border>

            <!--  ===== 游戏头像栏：点哪个游戏，下面的资源列表就换成哪个游戏的 =====  -->
            <Border Grid.Row="1" Style="{ThemeResource OmniXGlassCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  标题和内核状态并成一行：「选择游戏 · 「鸣潮」的管理功能已就绪」  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextWrapping="WrapWholeWords">
                            <Run Text="选择游戏" />
                            <Run
                                FontSize="12"
                                FontWeight="Normal"
                                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                Text="{Binding KernelStatusText, Mode=OneWay, TargetNullValue={x:Null}}" />
                        </TextBlock>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Command="{Binding InstallKernelCommand}"
                                Content="安装这个功能"
                                Style="{ThemeResource OmniXGhostButtonStyle}"
                                Visibility="{Binding CanInstallKernelVisibility}"
            l:Uids.Uid="/HomePreset/Feature_InstallKernelButton" />
                            <Button
                                Command="{Binding ImportOfflinePackageCommand}"
                                Content="导入离线包"
                                Style="{ThemeResource OmniXGhostButtonStyle}"
            l:Uids.Uid="/HomePreset/Feature_ImportButton" />
                            <Button
                                Command="{Binding CreatePluginTemplateCommand}"
                                Content="插件模板"
                                Style="{ThemeResource OmniXGhostButtonStyle}"
            l:Uids.Uid="/HomePreset/Feature_TemplateButton" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GameAvatarItem">
                                <Button
                                    Padding="6"
                                    Click="GameAvatar_OnClick"
                                    Opacity="{x:Bind ItemOpacity, Mode=OneWay}"
                                    Tag="{x:Bind Id}">
                                    <StackPanel
                                        Width="86"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                        <Grid Width="54" Height="54" HorizontalAlignment="Center">
                                            <Image
                                                Source="{x:Bind Icon, Mode=OneWay}"
                                                Stretch="Uniform" />
                                            <FontIcon
                                                FontSize="26"
                                                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                                Glyph="&#xE713;"
                                                Visibility="{x:Bind FallbackIconVisibility, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="10"
                                            Opacity="0.65"
                                            Text="未下载"
                                            Visibility="{x:Bind NotInstalledVisibility, Mode=OneWay}"
            l:Uids.Uid="/HomePreset/Feature_NotInstalled" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  ===== 功能格子：定宽卡片，按窗口宽度自动换行 =====  -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel
                            HorizontalSpacing="14"
                            Orientation="Horizontal"
                            VerticalSpacing="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="288"
                            Height="272"
                            fx:GlassFx.Attach="True"
                            Background="{ThemeResource OmniXGlassBackgroundBrush}"
                            BorderBrush="{ThemeResource OmniXGlassEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    Padding="16,22,16,14"
                                    VerticalAlignment="Center"
                                    Spacing="10">

                                    <Border
                                        Width="76"
                                        Height="76"
                                        HorizontalAlignment="Center"
                                        Background="{Binding BadgeBackground}"
                                        CornerRadius="38">
                                        <FontIcon
                                            FontSize="30"
                                            Foreground="{Binding BadgeForeground}"
                                            Glyph="{Binding Glyph}" />
                                    </Border>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="16.5"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource OmniXTextPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                        MaxLines="3"
                                        Text="{Binding Description}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding DescriptionVisibility}" />

                                    <!--  下载 / 部署进度  -->
                                    <StackPanel
                                        Margin="0,4,0,0"
                                        Spacing="6"
                                        Visibility="{Binding DownloadVisibility}">
                                        <ProgressBar
                                            Width="210"
                                            HorizontalAlignment="Center"
                                            IsIndeterminate="{Binding DownloadIndeterminate}"
                                            Maximum="100"
                                            Value="{Binding DownloadPercent}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                            Text="{Binding DownloadText}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{Binding StatusBrush}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{Binding StatusBrush}"
                                            Text="{Binding Status}" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  底部两个操作  -->
                                <Border
                                    Grid.Row="1"
                                    BorderBrush="{ThemeResource OmniXCardStrokeBrush}"
                                    BorderThickness="0,1,0,0">
                                    <Grid Height="46">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="{Binding PrimaryText}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding PrimaryCommand}"
                                            CornerRadius="0"
                                            IsEnabled="{Binding PrimaryEnabled}"
                                            ToolTipService.ToolTip="{Binding PrimaryText}">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource OmniXAccentBrush}"
                                                Opacity="{Binding PrimaryOpacity}"
                                                Text="{Binding PrimaryText}" />
                                        </Button>

                                        <Border
                                            Grid.Column="1"
                                            Width="1"
                                            Background="{ThemeResource OmniXCardStrokeBrush}" />

                                        <Button
                                            Grid.Column="2"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="{Binding SecondaryText}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SecondaryCommand}"
                                            CornerRadius="0"
                                            ToolTipService.ToolTip="{Binding SecondaryText}">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                                Text="{Binding SecondaryText}" />
                                        </Button>

                                        <!--  部署 / 卸载 或 启用 / 停用  -->
                                        <Border
                                            Grid.Column="3"
                                            Width="1"
                                            Background="{ThemeResource OmniXCardStrokeBrush}"
                                            Visibility="{Binding SwitchVisibility}" />

                                        <Button
                                            Grid.Column="4"
                                            MinWidth="74"
                                            Padding="12,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="{Binding ToggleText}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ToggleCommand}"
                                            CornerRadius="0"
                                            IsEnabled="{Binding SwitchEnabled}"
                                            ToolTipService.ToolTip="{Binding SwitchToolTip}"
                                            Visibility="{Binding SwitchVisibility}">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                                Text="{Binding ToggleText}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>
