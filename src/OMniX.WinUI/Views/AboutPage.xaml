<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OMniX.WinUI.Views.AboutPage"
    xmlns:l="using:WinUI3Localizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>

        <!--  卡片外观跟 Mod 总览那几张保持一致  -->
        <Style x:Key="AboutCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource OmniXCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource OmniXCardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20,16,20,18" />
        </Style>

        <Style x:Key="AboutCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AboutBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>

        <Style x:Key="AboutMutedStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="AboutRowLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="96" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
        </Style>

        <!--  二维码：白底 + 圆角，扫起来比直接贴图上清楚  -->
        <Style x:Key="AboutQrFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!--
            以后要加板块就复制下面这样一个 <Border> 整块，改里面的文字即可：

            <Border Style="{StaticResource AboutCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock l:Uids.Uid="/SettingsUi/Ab_NewSection" Style="{StaticResource AboutCardTitleStyle}" Text="新板块" />
                    <TextBlock l:Uids.Uid="/SettingsUi/Ab_Contents" Style="{StaticResource AboutBodyStyle}" Text="内容" />
                </StackPanel>
            </Border>
        -->

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="980"
            Margin="0,4,0,32"
            HorizontalAlignment="Left"
            Spacing="14">

            <!--  ===== 标题 =====  -->
            <StackPanel Margin="0,0,0,6" Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="关于 OMniX"
            l:Uids.Uid="/HomePreset/About_Title"/>
                <TextBlock Style="{StaticResource AboutMutedStyle}" Text="OMniX 是什么、能做什么、谁做的"
            l:Uids.Uid="/HomePreset/About_Subtitle"/>
            </StackPanel>

            <!--  ===== 这是什么 =====  -->
            <Border Style="{StaticResource AboutCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="这是什么"
            l:Uids.Uid="/HomePreset/About_WhatIsCardTitle"/>
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="OMniX" />
                    <TextBlock Style="{StaticResource AboutMutedStyle}" Text="{x:Bind ViewModel.AppVersionText}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource AboutBodyStyle}"
                        Text="多游戏 Mod 管理器。内置鸣潮内核，绝区零 / 原神 / 崩铁内核可随时下载切换；按角色整理 Mod、一键开关、存预设，Mod 文件本身还在原处，这个程序只负责管。"
            l:Uids.Uid="/HomePreset/About_Description"/>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource AboutMutedStyle}"
                        Text="完全免费、开源，不收任何费用。有人跟你要钱才给安装包，那就是骗子。"
            l:Uids.Uid="/HomePreset/About_FreeNotice"/>
                </StackPanel>
            </Border>

            <!--  ===== 能做什么 =====  -->
            <Border Style="{StaticResource AboutCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="能做什么"
            l:Uids.Uid="/HomePreset/About_FeaturesCardTitle"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="多游戏"
            l:Uids.Uid="/HomePreset/About_FeatureMultiKernelLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="内置鸣潮内核，绝区零 / 原神 / 崩铁内核在首页即可下载，右上角一键切换"
            l:Uids.Uid="/HomePreset/About_FeatureMultiKernelDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="角色管理"
            l:Uids.Uid="/HomePreset/About_FeatureCharactersLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="角色以头像墙列出，可搜索、置顶、隐藏，也能自己新建"
            l:Uids.Uid="/HomePreset/About_FeatureCharactersDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="Mod 开关"
            l:Uids.Uid="/HomePreset/About_FeatureToggleLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="单个 Mod 或整个角色一键启用 / 禁用"
            l:Uids.Uid="/HomePreset/About_FeatureToggleDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="Mod 预设"
            l:Uids.Uid="/HomePreset/About_FeaturePresetLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="一套 Mod 组合存成预设，切换时批量应用，可导出可复制"
            l:Uids.Uid="/HomePreset/About_FeaturePresetDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="Mod 编辑"
            l:Uids.Uid="/HomePreset/About_FeatureEditLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="改名称、作者、描述、星级，调整 Mod 内部的分段与优先级"
            l:Uids.Uid="/HomePreset/About_FeatureEditDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="回收站"
            l:Uids.Uid="/HomePreset/About_FeatureRecycleLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="删掉的 Mod 先进回收站，误删了还能恢复"
            l:Uids.Uid="/HomePreset/About_FeatureRecycleDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="更新检测"
            l:Uids.Uid="/HomePreset/About_FeatureUpdateLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="比对本地文件时间戳，把有变动的 Mod 标出来"
            l:Uids.Uid="/HomePreset/About_FeatureUpdateDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="Mod 修复"
            l:Uids.Uid="/HomePreset/About_FeatureFixerLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="内置 Wuwa Mod Fixer，可直接在程序里下载并运行"
            l:Uids.Uid="/HomePreset/About_FeatureFixerDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="启动游戏"
            l:Uids.Uid="/HomePreset/About_FeatureLaunchLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="按游戏自动识别启动方式：鸣潮走官方启动器，绝区零走 XXMI，原神 / 崩铁走 HoYo"
            l:Uids.Uid="/HomePreset/About_FeatureLaunchDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="迁移"
            l:Uids.Uid="/HomePreset/About_FeatureMigrateLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="Mod 可以在角色之间移动或复制"
            l:Uids.Uid="/HomePreset/About_FeatureMigrateDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="功能专区"
            l:Uids.Uid="/HomePreset/About_FeatureFeaturePackLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="每个游戏的管理功能独立成资源包，可在线下载，也支持离线 zip 导入"
            l:Uids.Uid="/HomePreset/About_FeatureFeaturePackDesc"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="数据目录"
            l:Uids.Uid="/HomePreset/About_FeatureDataRootLabel"/>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="数据按游戏分目录存放，可挪到任意盘，设置里能按类清理缓存与日志"
            l:Uids.Uid="/HomePreset/About_FeatureDataRootDesc"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== 作者 =====  -->
            <Border Style="{StaticResource AboutCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!--  作者头像：取自表情包的 gif 首帧，居中裁成正方形  -->
                    <Border
                        Width="56"
                        Height="56"
                        CornerRadius="16">
                        <Border.Background>
                            <ImageBrush ImageSource="ms-appx:///Assets/About/author.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="是湫"
            l:Uids.Uid="/HomePreset/About_AuthorName"/>
                        <TextBlock Style="{StaticResource AboutMutedStyle}" Text="程序 · 界面 · 动效"
            l:Uids.Uid="/HomePreset/About_AuthorRole"/>
                        <TextBlock Style="{StaticResource AboutMutedStyle}" Text="有什么想加的、用着不顺手的，都能提。"
            l:Uids.Uid="/HomePreset/About_AuthorNote"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ===== 交流群 =====  -->
            <Border Style="{StaticResource AboutCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="交流群"
            l:Uids.Uid="/HomePreset/About_GroupCardTitle"/>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource AboutQrFrameStyle}">
                            <Image
                                Width="168"
                                Height="168"
                                Source="ms-appx:///Assets/About/group-qr.jpg" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <TextBlock Style="{StaticResource AboutBodyStyle}" Text="扫一扫进群，用着有问题、想加什么功能，都能在这儿说。"
            l:Uids.Uid="/HomePreset/About_GroupBody"/>
                            <TextBlock Style="{StaticResource AboutMutedStyle}" Text="群里也能拿到最新版安装包，别的地方下的请不要用。"
            l:Uids.Uid="/HomePreset/About_GroupWarning"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== 投喂 =====  -->
            <Border Style="{StaticResource AboutCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="请我喝杯奶茶"
            l:Uids.Uid="/HomePreset/About_DonateCardTitle"/>

                    <TextBlock
                        Style="{StaticResource AboutBodyStyle}"
                        Text="软件一直免费，这个纯粹是自愿的 —— 觉得好用、想支持一下再扫，不扫也完全没关系。"
            l:Uids.Uid="/HomePreset/About_DonateBody"/>

                    <StackPanel
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Spacing="24">
                        <StackPanel Spacing="6">
                            <Border Style="{StaticResource AboutQrFrameStyle}">
                                <Image
                                    Width="152"
                                    Height="152"
                                    Source="ms-appx:///Assets/About/wechat-pay.png" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource AboutMutedStyle}"
                                Text="微信"
            l:Uids.Uid="/HomePreset/About_WechatLabel"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Border Style="{StaticResource AboutQrFrameStyle}">
                                <Image
                                    Width="152"
                                    Height="152"
                                    Source="ms-appx:///Assets/About/alipay-pay.png" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource AboutMutedStyle}"
                                Text="支付宝"
            l:Uids.Uid="/HomePreset/About_AlipayLabel"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ===== 项目主页 =====  -->
            <Border Style="{StaticResource AboutCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource AboutCardTitleStyle}" Text="项目主页"
            l:Uids.Uid="/HomePreset/About_RepoCardTitle"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AboutRowLabelStyle}" Text="GitHub" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AboutBodyStyle}"
                            Text="github.com/aiertana/OMnix" />
                    </Grid>

                    <Button
    Margin="0,10,0,0"
    Click="OpenProjectButton_OnClick"
    Content="打开项目主页"
    l:Uids.Uid="/HomePreset/About_OpenRepoButton"
    Style="{ThemeResource OmniXGhostButtonStyle}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
