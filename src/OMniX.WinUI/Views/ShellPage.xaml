<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OMniX.WinUI.Views.ShellPage"
    xmlns:l="using:WinUI3Localizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:behaviors="using:OMniX.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fx="using:OMniX.WinUI.Helpers.Xaml"
    xmlns:helpers="using:OMniX.WinUI.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  二开：侧边栏导航项统一高度和间距，比原来挤在一起更清爽  -->
        <Style x:Key="OmniXNavItemStyle" TargetType="NavigationViewItem">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="ShellRoot"
        fx:MotionFx.Scan="True"
        Background="{ThemeResource OmniXPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            二开：标准版的流动光斑。铺在内容底下慢慢飘，
            不参与命中测试，所以点谁都还是点谁。简易版直接不显示。
        -->
        <Grid
            x:Name="FlowLayer"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="1"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.FlowLayerVisibility, Mode=OneWay}">
            <Ellipse
                x:Name="FlowWarm"
                Width="720"
                Height="720"
                Margin="-120,-160,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#2EE5484D" />
                        <GradientStop Offset="0.55" Color="#14E5484D" />
                        <GradientStop Offset="1" Color="#00E5484D" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="FlowWarmMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse
                x:Name="FlowCool"
                Width="640"
                Height="640"
                Margin="0,0,-140,-120"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#247B8794" />
                        <GradientStop Offset="0.55" Color="#107B8794" />
                        <GradientStop Offset="1" Color="#007B8794" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="FlowCoolMove" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <NavigationView
            x:Name="NavigationViewControl"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="0"
            Background="Transparent"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
            ExpandedModeThresholdWidth="641"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsPaneVisible="{x:Bind ViewModel.IsNotFirstTimeStartupPage, Mode=OneWay}"
            IsSettingsVisible="True"
            MenuItemContainerStyle="{StaticResource OmniXNavItemStyle}"
            OpenPaneLength="240"
            PaneDisplayMode="Left"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">

            <!--  ===== 侧栏顶部：Logo =====  -->
            <NavigationView.PaneCustomContent>
                <StackPanel Margin="16,0,16,12" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="36"
                            Height="36"
                            Padding="1"
                            Background="{ThemeResource OmniXCardBackgroundBrush}"
                            CornerRadius="10"
                            BorderBrush="{ThemeResource OmniXCardStrokeBrush}"
                            BorderThickness="1">
                            <Image Source="ms-appx:///Assets/OMniX-logo.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <!--  二开：直接用 logo 原图里的 OMniX 字样（黑/红/灰/黑底白 x），不再是纯色文字  -->
                            <Image
                                Height="24"
                                Margin="0,1,0,2"
                                HorizontalAlignment="Left"
                                Source="ms-appx:///Assets/OMniX-wordmark.png"
                                Stretch="Uniform" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                Text="MOD MANAGER" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <!--  角色分类由 ShellPage.xaml.cs 动态插入到「首页」之后  -->

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.HomeViewModel" Content="首页"
            l:Uids.Uid="/ShellUi/Shell_NavHome">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.ModsOverviewVM" Content="Mod 总览"
            l:Uids.Uid="/ShellUi/Shell_NavModsOverview">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA37;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.CharacterManagerViewModel" Content="角色管理"
            l:Uids.Uid="/ShellUi/Shell_NavCharacters">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEB7E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.PresetViewModel" Content="预设配置"
            l:Uids.Uid="/ShellUi/Shell_NavPresets">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA41;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.ModInstallerVM" Content="Mod 安装"
            l:Uids.Uid="/ShellUi/Shell_NavModInstaller">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.PluginAreaViewModel" Content="插件专区"
            l:Uids.Uid="/ShellUi/Shell_NavPluginArea">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9F0;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="DebugItem"
                    helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.DebugViewModel"
                    Content="调试"
            l:Uids.Uid="/ShellUi/Shell_NavDebug">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--  ===== 二开：插件开关（Mod 加载 / DLSS5 渲染链）  =====  -->
                <NavigationViewItem
                    x:Name="ModPluginItem"
                    SelectsOnInvoked="False"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ModToolTip, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74C;" />
                    </NavigationViewItem.Icon>
                    <StackPanel
                        MinWidth="132"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="Mod" />
                        <ToggleSwitch
                            x:Name="ModToggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="ModToggle_OnToggled" />
                    </StackPanel>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="Dlss5PluginItem"
                    SelectsOnInvoked="False"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Dlss5ToolTip, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                    <StackPanel
                        MinWidth="132"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="DLSS5" />
                        <ToggleSwitch
                            x:Name="Dlss5Toggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="Dlss5Toggle_OnToggled" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.NotificationsViewModel" Content="通知"
            l:Uids.Uid="/ShellUi/Shell_NavNotifications">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7E7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--  关于页：整页，不是弹窗，内容都在 Views/AboutPage.xaml 里  -->
                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.AboutViewModel" Content="关于"
            l:Uids.Uid="/ShellUi/Shell_NavAbout">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!--  ===== 侧栏底部：教程 + 启动游戏 =====  -->
            <NavigationView.PaneFooter>
                <StackPanel
                    Margin="16,4,16,14"
                    Spacing="8">
                    <!--  「关于」已经挪到下面的导航项里了，这里只留教程 -->
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="TutorialButton_OnClick"
                        Style="{ThemeResource OmniXGhostButtonStyle}"
                        ToolTipService.ToolTip="打开 GitHub 上的使用说明"
            l:Uids.Uid="/ShellUi/Shell_TutorialTip">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <!--  原来是 E82D，这个码位在 Segoe Fluent Icons 里没有，一直显示成方块  -->
                            <FontIcon FontSize="12" Glyph="&#xE8A5;" />
                            <TextBlock FontSize="12" Text="查看使用教程"
            l:Uids.Uid="/ShellUi/Shell_TutorialText"/>
                        </StackPanel>
                    </Button>

                    <Button
                        Height="44"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.LaunchGameCommand, Mode=OneWay}"
                        Content="{x:Bind ViewModel.LaunchGameText, Mode=OneWay}"
                        Style="{ThemeResource OmniXAccentButtonStyle}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="10"
                        Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid Margin="48,48,48,0">
                <TeachingTip
                    Title="{x:Bind ViewModel.NotificationManager.ActiveNotification.Title, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.NotificationManager.IsNotificationActive, Mode=TwoWay}"
                    Subtitle="{x:Bind ViewModel.NotificationManager.ActiveNotification.Subtitle, Mode=OneWay}" />
                <Frame x:Name="NavigationFrame" />
            </Grid>
        </NavigationView>

        <!--  ===== 自定义标题栏（内容区顶部，可拖动） =====  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Margin="216,0,0,0"
            Background="Transparent"
            Canvas.ZIndex="2">
            <StackPanel
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    Width="14"
                    Height="14"
                    Source="/Assets/WindowIcon.ico" />
                <TextBlock
                    x:Name="AppTitleBarText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>

        <!--
            二开：点击粒子层。铺满整个窗口盖在最上面，
            IsHitTestVisible=False 所以不挡任何点击，只在上面画飞散的粒子。
        -->
        <Canvas
            x:Name="FxLayer"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="99"
            IsHitTestVisible="False" />
    </Grid>

</Page>
