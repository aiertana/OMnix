<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OMniX.WinUI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:behaviors="using:OMniX.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:OMniX.WinUI.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  二开：侧边栏导航项统一高度和间距，比原来挤在一起更清爽  -->
        <Style x:Key="OmniXNavItemStyle" TargetType="NavigationViewItem">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="8,2" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource OmniXPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavigationViewControl"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="0"
            Background="Transparent"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
            ExpandedModeThresholdWidth="641"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsPaneVisible="{x:Bind ViewModel.IsNotFirstTimeStartupPage, Mode=OneWay}"
            IsSettingsVisible="True"
            MenuItemContainerStyle="{StaticResource OmniXNavItemStyle}"
            OpenPaneLength="216"
            PaneDisplayMode="Left"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">

            <!--  ===== 侧栏顶部：Logo =====  -->
            <NavigationView.PaneCustomContent>
                <StackPanel Margin="16,0,16,12" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="32"
                            Height="32"
                            Padding="1"
                            Background="{ThemeResource OmniXCardBackgroundBrush}"
                            CornerRadius="10"
                            BorderBrush="{ThemeResource OmniXCardStrokeBrush}"
                            BorderThickness="1">
                            <Image Source="ms-appx:///Assets/OMniX-logo.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <!--  二开：直接用 logo 原图里的 OMniX 字样（黑/红/灰/黑底白 x），不再是纯色文字  -->
                            <Image
                                Height="24"
                                Margin="0,1,0,2"
                                HorizontalAlignment="Left"
                                Source="ms-appx:///Assets/OMniX-wordmark.png"
                                Stretch="Uniform" />
                            <TextBlock
                                FontSize="9"
                                Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                                Text="MOD MANAGER" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <!--  角色分类由 ShellPage.xaml.cs 动态插入到「首页」之后  -->

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.HomeViewModel" Content="首页">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.ModsOverviewVM" Content="Mod 总览">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA37;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.CharacterManagerViewModel" Content="角色管理">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEB7E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.PresetViewModel" Content="预设配置">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA41;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.ModInstallerVM" Content="Mod 安装">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.PluginAreaViewModel" Content="插件专区">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9F0;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="DebugItem"
                    helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.DebugViewModel"
                    Content="调试">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--  ===== 二开：插件开关（Mod 加载 / DLSS5 渲染链）  =====  -->
                <NavigationViewItem
                    x:Name="ModPluginItem"
                    SelectsOnInvoked="False"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ModToolTip, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74C;" />
                    </NavigationViewItem.Icon>
                    <StackPanel
                        MinWidth="132"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="Mod" />
                        <ToggleSwitch
                            x:Name="ModToggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="ModToggle_OnToggled" />
                    </StackPanel>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="Dlss5PluginItem"
                    SelectsOnInvoked="False"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Dlss5ToolTip, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                    <StackPanel
                        MinWidth="132"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="DLSS5" />
                        <ToggleSwitch
                            x:Name="Dlss5Toggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="Dlss5Toggle_OnToggled" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem helpers:NavigationHelper.NavigateTo="OMniX.WinUI.ViewModels.NotificationsViewModel" Content="通知">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7E7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!--  ===== 侧栏底部：教程 + 启动游戏 =====  -->
            <NavigationView.PaneFooter>
                <StackPanel
                    Margin="16,4,16,14"
                    Spacing="8">
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="TutorialButton_OnClick"
                        Style="{ThemeResource OmniXGhostButtonStyle}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE82D;" />
                            <TextBlock FontSize="12" Text="查看使用教程" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="40"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.LaunchGameCommand, Mode=OneWay}"
                        Content="{x:Bind ViewModel.LaunchGameText, Mode=OneWay}"
                        Style="{ThemeResource OmniXAccentButtonStyle}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="10"
                        Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid Margin="48,48,48,0">
                <TeachingTip
                    Title="{x:Bind ViewModel.NotificationManager.ActiveNotification.Title, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.NotificationManager.IsNotificationActive, Mode=TwoWay}"
                    Subtitle="{x:Bind ViewModel.NotificationManager.ActiveNotification.Subtitle, Mode=OneWay}" />
                <Frame x:Name="NavigationFrame" />
            </Grid>
        </NavigationView>

        <!--  ===== 自定义标题栏（内容区顶部，可拖动） =====  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Margin="216,0,0,0"
            Background="Transparent"
            Canvas.ZIndex="2">
            <StackPanel
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    Width="14"
                    Height="14"
                    Source="/Assets/WindowIcon.ico" />
                <TextBlock
                    x:Name="AppTitleBarText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource OmniXTextSecondaryBrush}"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>
    </Grid>

</Page>
