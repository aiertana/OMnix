<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ========== 配色：黑 / 白 / 红 —— 明暗两套，靠 RequestedTheme 切换 ==========  -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
                <!--  二开：把 WinUI 的系统 accent 也换成珊瑚红。
                      弹窗主按钮、输入框聚焦下划线、FocusVisual 这些用的都是 SystemAccentColor 派生出的画刷，
                      不覆盖的话永远是系统蓝（在 ThemeDictionaries 里定义，优先级才压得住内置值）。  -->
                <Color x:Key="SystemAccentColor">#FFE5484D</Color>
                <Color x:Key="SystemAccentColorLight1">#FFFF7A84</Color>
                <Color x:Key="SystemAccentColorLight2">#FFFF9EA6</Color>
                <Color x:Key="SystemAccentColorLight3">#FFFFC0C4</Color>
                <Color x:Key="SystemAccentColorDark1">#FFC9172A</Color>
                <Color x:Key="SystemAccentColorDark2">#FFA51020</Color>
                <Color x:Key="SystemAccentColorDark3">#FF7E0A17</Color>
                <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFE5484D" />
                <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6E5484D" />
                <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCE5484D" />
                <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#33E5484D" />
                <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFE5484D" />
                <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFE5484D" />
                <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFE5484D" />

                <!--  强调色：logo 里那个玫红 / 珊瑚红  -->
                <Color x:Key="OmniXAccentColor">#FFE5484D</Color>
                <Color x:Key="OmniXAccentSoftColor">#FFFFECEC</Color>
                <Color x:Key="OmniXAccentSoftHoverColor">#FFFFDDDD</Color>
                <Color x:Key="OmniXAccentSoftPressedColor">#FFFFCFCF</Color>
                <Color x:Key="OmniXAccentStrongColor">#FFFF6B75</Color>
                <!--  卡片 / 面板：带 alpha，让窗口的亚克力背景透上来  -->
                <Color x:Key="OmniXCardAltBackgroundColor">#7AFFFFFF</Color>
                <Color x:Key="OmniXCardBackgroundColor">#99FFFFFF</Color>
                <!--  玻璃边框用白色半透明，模拟边缘高光  -->
                <Color x:Key="OmniXCardStrokeColor">#99FFFFFF</Color>
                <Color x:Key="OmniXCardStrokeHoverColor">#FFFFB3B5</Color>
                <Color x:Key="OmniXControlBackgroundColor">#B3FFFFFF</Color>
                <Color x:Key="OmniXControlBorderColor">#80D8D8DE</Color>
                <Color x:Key="OmniXControlBorderPointerOverColor">#FFE0A7A9</Color>
                <Color x:Key="OmniXGlassTintColor">#FFFFFFFF</Color>
                <Color x:Key="OmniXHeroBackgroundColor">#D9FFFFFF</Color>
                <Color x:Key="OmniXNavGlassTintColor">#FFFFFFFF</Color>
                <Color x:Key="OmniXNavItemPointerOverColor">#59F3F3F6</Color>
                <Color x:Key="OmniXNavItemPressedColor">#73EAEAEF</Color>
                <Color x:Key="OmniXNavItemSelectedColor">#FFFFE8E8</Color>
                <Color x:Key="OmniXNavItemSelectedPointerOverColor">#FFFFDDDD</Color>
                <Color x:Key="OmniXNavItemSelectedPressedColor">#FFFFCFCF</Color>
                <Color x:Key="OmniXNavPaneBackgroundColor">#99FFFFFF</Color>
                <Color x:Key="OmniXPageBackgroundColor">#B3F0F0F3</Color>
                <Color x:Key="OmniXPureWhiteColor">#FFFFFFFF</Color>
                <Color x:Key="OmniXSidebarBackgroundColor">#99FFFFFF</Color>
                <Color x:Key="OmniXTextOnHeroColor">#FFFFFFFF</Color>
                <!--  文字压深，玻璃底上要更清楚  -->
                <Color x:Key="OmniXTextPrimaryColor">#FF111114</Color>
                <Color x:Key="OmniXTextSecondaryColor">#FF5A5A66</Color>
                <Color x:Key="OmniXTextSecondaryOnHeroColor">#FFFFE3E3</Color>
                <Color x:Key="OmniXWarmColor">#FFFF8A6B</Color>
                <Color x:Key="OmniXWarmDeepColor">#FFD84A2F</Color>
                <!--  弹窗：玻璃底，但要够实，保证文字清晰  -->
                <Color x:Key="OmniXDialogBackgroundColor">#C4FFFFFF</Color>
                <Color x:Key="OmniXDialogBorderColor">#80E5E5EA</Color>

                <!--  二开：柔光底色（淡紫 → 淡粉 → 淡蓝）。
                      半透明卡片要有色彩层次垫底才像玻璃，纯灰底怎么调都是一片白。  -->
                <LinearGradientBrush x:Key="OmniXPageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#E6DCD5F7" />
                    <GradientStop Offset="0.45" Color="#E8EEE2F4" />
                    <GradientStop Offset="1" Color="#E6D8E4F8" />
                </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
                <!--  二开：深色下的系统 accent 覆盖，和亮色一一对应  -->
                <Color x:Key="SystemAccentColor">#FFFF6B75</Color>
                <Color x:Key="SystemAccentColorLight1">#FFFF8A92</Color>
                <Color x:Key="SystemAccentColorLight2">#FFFFA8AE</Color>
                <Color x:Key="SystemAccentColorLight3">#FFFFC6CA</Color>
                <Color x:Key="SystemAccentColorDark1">#FFE5484D</Color>
                <Color x:Key="SystemAccentColorDark2">#FFC9172A</Color>
                <Color x:Key="SystemAccentColorDark3">#FFA51020</Color>
                <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFF6B75" />
                <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FF6B75" />
                <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFF6B75" />
                <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#33FF6B75" />
                <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFF8A92" />
                <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFFF8A92" />
                <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFFF8A92" />

                <!--  深色：近黑玻璃底 + 珊瑚红  -->
                <Color x:Key="OmniXAccentColor">#FFFF6B75</Color>
                <Color x:Key="OmniXAccentSoftColor">#FF3A2224</Color>
                <Color x:Key="OmniXAccentSoftHoverColor">#FF4A2C2E</Color>
                <Color x:Key="OmniXAccentSoftPressedColor">#FF553336</Color>
                <Color x:Key="OmniXAccentStrongColor">#FFFF8A92</Color>
                <Color x:Key="OmniXCardAltBackgroundColor">#6626262C</Color>
                <Color x:Key="OmniXCardBackgroundColor">#80202026</Color>
                <!--  深色玻璃靠白色细边勾轮廓  -->
                <Color x:Key="OmniXCardStrokeColor">#73FFFFFF</Color>
                <Color x:Key="OmniXCardStrokeHoverColor">#FF7A4048</Color>
                <Color x:Key="OmniXControlBackgroundColor">#9926262C</Color>
                <Color x:Key="OmniXControlBorderColor">#663A3A44</Color>
                <Color x:Key="OmniXControlBorderPointerOverColor">#FF7A4048</Color>
                <Color x:Key="OmniXGlassTintColor">#FF1F1F24</Color>
                <Color x:Key="OmniXHeroBackgroundColor">#99202026</Color>
                <Color x:Key="OmniXNavGlassTintColor">#FF1B1B1F</Color>
                <Color x:Key="OmniXNavItemPointerOverColor">#662A2A31</Color>
                <Color x:Key="OmniXNavItemPressedColor">#8033333B</Color>
                <Color x:Key="OmniXNavItemSelectedColor">#FF3A2224</Color>
                <Color x:Key="OmniXNavItemSelectedPointerOverColor">#FF4A2C2E</Color>
                <Color x:Key="OmniXNavItemSelectedPressedColor">#FF553336</Color>
                <Color x:Key="OmniXNavPaneBackgroundColor">#B3141418</Color>
                <Color x:Key="OmniXPageBackgroundColor">#990E0E11</Color>
                <Color x:Key="OmniXPureWhiteColor">#FFFFFFFF</Color>
                <Color x:Key="OmniXSidebarBackgroundColor">#B3141418</Color>
                <Color x:Key="OmniXTextOnHeroColor">#FFFFFFFF</Color>
                <Color x:Key="OmniXTextPrimaryColor">#FFF7F7FA</Color>
                <Color x:Key="OmniXTextSecondaryColor">#FFAEAEBC</Color>
                <Color x:Key="OmniXTextSecondaryOnHeroColor">#FFD9C7C9</Color>
                <Color x:Key="OmniXWarmColor">#FFFF9E80</Color>
                <Color x:Key="OmniXWarmDeepColor">#FFE85A40</Color>
                <Color x:Key="OmniXDialogBackgroundColor">#B31A1A20</Color>
                <Color x:Key="OmniXDialogBorderColor">#59FFFFFF</Color>

                <!--  二开：深色主题的底，近黑里带一点紫，和亮色版对应  -->
                <LinearGradientBrush x:Key="OmniXPageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#F216121C" />
                    <GradientStop Offset="0.5" Color="#F2121219" />
                    <GradientStop Offset="1" Color="#F20F1418" />
                </LinearGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>





            <!--  毛玻璃着色  -->

            <!--  NavigationView / 输入框覆盖  -->

            <SolidColorBrush x:Key="OmniXAccentBrush" Color="{ThemeResource OmniXAccentColor}" />
            <SolidColorBrush x:Key="OmniXAccentStrongBrush" Color="{ThemeResource OmniXAccentStrongColor}" />
            <SolidColorBrush x:Key="OmniXAccentSoftBrush" Color="{ThemeResource OmniXAccentSoftColor}" />
            <SolidColorBrush x:Key="OmniXAccentSoftHoverBrush" Color="{ThemeResource OmniXAccentSoftHoverColor}" />
            <SolidColorBrush x:Key="OmniXAccentSoftPressedBrush" Color="{ThemeResource OmniXAccentSoftPressedColor}" />
            <!--  二开：页面背景改到 ThemeDictionaries 里定义成渐变（见下方 Light / Dark）。
                  原来这里是 SolidColorBrush 引用纯色，叠在窗口亚克力上就是一片灰白，
                  半透明卡片根本透不出「玻璃」的层次。  -->
            <SolidColorBrush x:Key="OmniXSidebarBackgroundBrush" Color="{ThemeResource OmniXSidebarBackgroundColor}" />
            <SolidColorBrush x:Key="OmniXCardBackgroundBrush" Color="{ThemeResource OmniXCardBackgroundColor}" />
            <SolidColorBrush x:Key="OmniXCardAltBackgroundBrush" Color="{ThemeResource OmniXCardAltBackgroundColor}" />
            <SolidColorBrush x:Key="OmniXCardStrokeBrush" Color="{ThemeResource OmniXCardStrokeColor}" />
            <SolidColorBrush x:Key="OmniXCardStrokeHoverBrush" Color="{ThemeResource OmniXCardStrokeHoverColor}" />
            <SolidColorBrush x:Key="OmniXHeroBackgroundBrush" Color="{ThemeResource OmniXHeroBackgroundColor}" />
            <SolidColorBrush x:Key="OmniXTextPrimaryBrush" Color="{ThemeResource OmniXTextPrimaryColor}" />
            <SolidColorBrush x:Key="OmniXTextSecondaryBrush" Color="{ThemeResource OmniXTextSecondaryColor}" />
            <SolidColorBrush x:Key="OmniXTextOnHeroBrush" Color="{ThemeResource OmniXTextOnHeroColor}" />
            <SolidColorBrush x:Key="OmniXTextSecondaryOnHeroBrush" Color="{ThemeResource OmniXTextSecondaryOnHeroColor}" />
            <SolidColorBrush x:Key="OmniXWarmBrush" Color="{ThemeResource OmniXWarmColor}" />
            <SolidColorBrush x:Key="OmniXPureWhiteBrush" Color="{ThemeResource OmniXPureWhiteColor}" />
            <SolidColorBrush x:Key="OmniXTransparentBrush" Color="Transparent" />
            <!--  二开：弹窗底用 AcrylicBrush 而不是纯色，
                  这样背后内容会被真正模糊（毛玻璃），FallbackColor 兜底低配/不支持的情况。  -->
            <AcrylicBrush
                x:Key="OmniXDialogBackgroundBrush"
                FallbackColor="{ThemeResource OmniXDialogBackgroundColor}"
                TintColor="{ThemeResource OmniXDialogBackgroundColor}"
                TintOpacity="0.55" />
            <SolidColorBrush x:Key="OmniXDialogBorderBrush" Color="{ThemeResource OmniXDialogBorderColor}" />

            <!--  二开：侧栏也做成玻璃，原来是纯白到浅灰的实色  -->
            <LinearGradientBrush x:Key="OmniXSidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#D9FFFFFF" />
                <GradientStop Offset="1" Color="#A6F0F0F3" />
            </LinearGradientBrush>
        


    <!--  ===== 通用渐变（红） =====  -->
    <!--  二开：渐变统一到 logo 的珊瑚红，去掉原来的橙味  -->
    <LinearGradientBrush x:Key="OmniXAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFF7A84" />
        <GradientStop Offset="1" Color="#FFC9172A" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OmniXWarmGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFF9E80" />
        <GradientStop Offset="1" Color="#FFD84A2F" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OmniXHeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFC9172A" />
        <GradientStop Offset="0.55" Color="#FFE5484D" />
        <GradientStop Offset="1" Color="#FFFF8A92" />
    </LinearGradientBrush>

    <!--  ========== 圆角 ==========  -->
    <CornerRadius x:Key="OmniXCardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="OmniXControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OmniXPillCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

    <!--  ========== 文本样式 ==========  -->
    <Style x:Key="OmniXPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="OmniXSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextPrimaryBrush}" />
    </Style>

    <Style x:Key="OmniXBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextPrimaryBrush}" />
    </Style>

    <Style x:Key="OmniXCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OmniXStrongCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXAccentStrongBrush}" />
    </Style>

    <!--  ========== 按钮：暗红底红字 ==========  -->
    <Style x:Key="OmniXSoftButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource OmniXAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXAccentStrongBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXControlCornerRadius}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.45"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ========== 按钮：红色渐变主按钮 ==========  -->
    <Style x:Key="OmniXAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource OmniXAccentGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXControlCornerRadius}" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.9"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.78"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.4"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ========== 按钮：橙红渐变 ==========  -->
    <Style
        x:Key="OmniXWarmButtonStyle"
        BasedOn="{StaticResource OmniXAccentButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource OmniXWarmGradientBrush}" />
    </Style>

    <!--  ========== 按钮：无底透明 ==========  -->
    <Style x:Key="OmniXGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXControlCornerRadius}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.4"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ========== 按钮：危险操作 ==========  -->
    <Style x:Key="OmniXDangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXAccentStrongBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniXCardStrokeHoverBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXControlCornerRadius}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.75"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.4"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ========== 胶囊开关 ==========  -->
    <Style x:Key="OmniXChipToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.4"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentStrongBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ========== 卡片 ==========  -->
    <Style x:Key="OmniXCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource OmniXCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniXCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXCardCornerRadius}" />
    </Style>

    <Style
        x:Key="OmniXAltCardStyle"
        BasedOn="{StaticResource OmniXCardStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource OmniXCardAltBackgroundBrush}" />
    </Style>

    <Style x:Key="OmniXPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource OmniXAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!--  ========== NavigationView 覆盖（跟随明暗） ==========  -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource OmniXNavItemSelectedColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource OmniXNavItemSelectedPointerOverColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource OmniXNavItemSelectedPressedColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource OmniXNavItemPointerOverColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{ThemeResource OmniXNavItemPressedColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

    <!--  ========== 输入框覆盖（跟随明暗） ==========  -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource OmniXControlBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource OmniXControlBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource OmniXControlBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource OmniXControlBorderColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource OmniXControlBorderPointerOverColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource OmniXAccentColor}" />

    <SolidColorBrush x:Key="OmniXTextBoxBackgroundBrush" Color="{ThemeResource OmniXControlBackgroundColor}" />
    <SolidColorBrush x:Key="OmniXTextBoxBorderBrush" Color="{ThemeResource OmniXControlBorderColor}" />
    <SolidColorBrush x:Key="OmniXComboBoxBackgroundBrush" Color="{ThemeResource OmniXControlBackgroundColor}" />
    <SolidColorBrush x:Key="OmniXComboBoxBorderBrush" Color="{ThemeResource OmniXControlBorderColor}" />

    <Style x:Key="OmniXTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource OmniXTextBoxBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniXTextBoxBorderBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextPrimaryBrush}" />
    </Style>

    <Style x:Key="OmniXComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource OmniXComboBoxBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniXComboBoxBorderBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextPrimaryBrush}" />
    </Style>

    <!--  ========== 磨砂玻璃（Acrylic） ==========
          注意：BasedOn 只能用 StaticResource，用 ThemeResource 会让 XamlCompiler 直接崩溃 -->
    <AcrylicBrush
        x:Key="OmniXGlassBackgroundBrush"
        FallbackColor="{StaticResource OmniXCardBackgroundColor}"
        TintColor="{StaticResource OmniXGlassTintColor}"
        TintLuminosityOpacity="0.72"
        TintOpacity="0.58" />

    <AcrylicBrush
        x:Key="OmniXNavGlassBrush"
        FallbackColor="{StaticResource OmniXSidebarBackgroundColor}"
        TintColor="{StaticResource OmniXNavGlassTintColor}"
        TintLuminosityOpacity="0.86"
        TintOpacity="0.74" />

    <AcrylicBrush
        x:Key="OmniXOverlayGlassBrush"
        FallbackColor="{StaticResource OmniXCardBackgroundColor}"
        TintColor="{StaticResource OmniXGlassTintColor}"
        TintLuminosityOpacity="0.9"
        TintOpacity="0.82" />

    <AcrylicBrush
        x:Key="OmniXHeroGlassBrush"
        FallbackColor="{StaticResource OmniXPureWhiteColor}"
        TintColor="{StaticResource OmniXPureWhiteColor}"
        TintLuminosityOpacity="0.55"
        TintOpacity="0.18" />

    <Style x:Key="OmniXGlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource OmniXGlassBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniXCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXCardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style
        x:Key="OmniXPlaceholderCardStyle"
        BasedOn="{StaticResource OmniXGlassCardStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource OmniXCardAltBackgroundBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style x:Key="OmniXSectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OmniXHeroButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource OmniXAccentGradientBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXPureWhiteBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="OmniXHeroIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource OmniXHeroGlassBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextOnHeroBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  ========== 二开：弹窗（全局） ==========
          用隐式样式（不写 x:Key），自动作用到每一个 ContentDialog，
          包括各页面里 new ContentDialog() 动态创建的，一个调用点都不用改。
          必须放在 OmniXAccentButtonStyle 之后，否则 StaticResource 取不到主按钮样式。  -->
    <Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="ContentDialog">
        <Setter Property="Background" Value="{StaticResource OmniXDialogBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OmniXDialogBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OmniXTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <!--  弹窗主按钮默认吃系统 accent（蓝色），换成本项目的珊瑚红渐变  -->
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource OmniXAccentButtonStyle}" />
    </Style>

</ResourceDictionary>
