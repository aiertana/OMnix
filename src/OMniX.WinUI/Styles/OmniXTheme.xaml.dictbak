<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ========== 配色：黑 / 白 / 红 —— 明暗两套，靠 RequestedTheme 切换 ==========  -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="OmniXAccentColor">#FFD92B18</Color>
            <Color x:Key="OmniXAccentStrongColor">#FFFF5A45</Color>
            <Color x:Key="OmniXAccentSoftColor">#FFFFECE9</Color>
            <Color x:Key="OmniXAccentSoftHoverColor">#FFFFDDD7</Color>
            <Color x:Key="OmniXAccentSoftPressedColor">#FFFFCFC8</Color>
            <Color x:Key="OmniXWarmColor">#FFFF8A4D</Color>
            <Color x:Key="OmniXWarmDeepColor">#FFD8461F</Color>

            <Color x:Key="OmniXPageBackgroundColor">#FFF7F7F9</Color>
            <Color x:Key="OmniXSidebarBackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="OmniXCardBackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="OmniXCardAltBackgroundColor">#FFFAFAFC</Color>
            <Color x:Key="OmniXCardStrokeColor">#FFE5E5EA</Color>
            <Color x:Key="OmniXCardStrokeHoverColor">#FFFFB3A8</Color>
            <Color x:Key="OmniXHeroBackgroundColor">#FFFFFFFF</Color>

            <Color x:Key="OmniXTextPrimaryColor">#FF1B1B1F</Color>
            <Color x:Key="OmniXTextSecondaryColor">#FF6B6B78</Color>
            <Color x:Key="OmniXTextOnHeroColor">#FFFFFFFF</Color>
            <Color x:Key="OmniXTextSecondaryOnHeroColor">#FFFFE3DE</Color>
            <Color x:Key="OmniXPureWhiteColor">#FFFFFFFF</Color>

            <!--  毛玻璃着色  -->
            <Color x:Key="OmniXGlassTintColor">#FFFFFFFF</Color>
            <Color x:Key="OmniXNavGlassTintColor">#FFFFFFFF</Color>

            <!--  NavigationView / 输入框覆盖  -->
            <Color x:Key="OmniXNavItemSelectedColor">#FFFFE8E5</Color>
            <Color x:Key="OmniXNavItemSelectedPointerOverColor">#FFFFDDD6</Color>
            <Color x:Key="OmniXNavItemSelectedPressedColor">#FFFFCFC8</Color>
            <Color x:Key="OmniXNavItemPointerOverColor">#FFF3F3F6</Color>
            <Color x:Key="OmniXNavItemPressedColor">#FFEAEAEF</Color>
            <Color x:Key="OmniXNavPaneBackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="OmniXControlBackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="OmniXControlBorderColor">#FFD8D8DE</Color>
            <Color x:Key="OmniXControlBorderPointerOverColor">#FFE0A79E</Color>

            <SolidColorBrush x:Key="OmniXAccentBrush" Color="#FFD92B18" />
            <SolidColorBrush x:Key="OmniXAccentStrongBrush" Color="#FFFF5A45" />
            <SolidColorBrush x:Key="OmniXAccentSoftBrush" Color="#FFFFECE9" />
            <SolidColorBrush x:Key="OmniXAccentSoftHoverBrush" Color="#FFFFDDD7" />
            <SolidColorBrush x:Key="OmniXAccentSoftPressedBrush" Color="#FFFFCFC8" />
            <SolidColorBrush x:Key="OmniXPageBackgroundBrush" Color="#FFF7F7F9" />
            <SolidColorBrush x:Key="OmniXSidebarBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OmniXCardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OmniXCardAltBackgroundBrush" Color="#FFFAFAFC" />
            <SolidColorBrush x:Key="OmniXCardStrokeBrush" Color="#FFE5E5EA" />
            <SolidColorBrush x:Key="OmniXCardStrokeHoverBrush" Color="#FFFFB3A8" />
            <SolidColorBrush x:Key="OmniXHeroBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OmniXTextPrimaryBrush" Color="#FF1B1B1F" />
            <SolidColorBrush x:Key="OmniXTextSecondaryBrush" Color="#FF6B6B78" />
            <SolidColorBrush x:Key="OmniXTextOnHeroBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OmniXTextSecondaryOnHeroBrush" Color="#FFFFE3DE" />
            <SolidColorBrush x:Key="OmniXWarmBrush" Color="#FFFF8A4D" />
            <SolidColorBrush x:Key="OmniXPureWhiteBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OmniXTransparentBrush" Color="Transparent" />

            <LinearGradientBrush x:Key="OmniXSidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="1" Color="#FFF2F2F5" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="OmniXAccentColor">#FFFF4A34</Color>
            <Color x:Key="OmniXAccentStrongColor">#FFFF6A55</Color>
            <Color x:Key="OmniXAccentSoftColor">#FF2A1412</Color>
            <Color x:Key="OmniXAccentSoftHoverColor">#FF3A1B18</Color>
            <Color x:Key="OmniXAccentSoftPressedColor">#FF4A2320</Color>
            <Color x:Key="OmniXWarmColor">#FFFF8A4D</Color>
            <Color x:Key="OmniXWarmDeepColor">#FFD8461F</Color>

            <Color x:Key="OmniXPageBackgroundColor">#FF0B0B0D</Color>
            <Color x:Key="OmniXSidebarBackgroundColor">#FF121215</Color>
            <Color x:Key="OmniXCardBackgroundColor">#FF16161A</Color>
            <Color x:Key="OmniXCardAltBackgroundColor">#FF1D1D22</Color>
            <Color x:Key="OmniXCardStrokeColor">#FF26262C</Color>
            <Color x:Key="OmniXCardStrokeHoverColor">#FF7A2A24</Color>
            <Color x:Key="OmniXHeroBackgroundColor">#FF08080A</Color>

            <Color x:Key="OmniXTextPrimaryColor">#FFF5F5F7</Color>
            <Color x:Key="OmniXTextSecondaryColor">#FF9A9AA4</Color>
            <Color x:Key="OmniXTextOnHeroColor">#FFFFFFFF</Color>
            <Color x:Key="OmniXTextSecondaryOnHeroColor">#FFB0B0B8</Color>
            <Color x:Key="OmniXPureWhiteColor">#FFFFFFFF</Color>

            <!--  毛玻璃着色  -->
            <Color x:Key="OmniXGlassTintColor">#FF16161A</Color>
            <Color x:Key="OmniXNavGlassTintColor">#FF121215</Color>

            <!--  NavigationView / 输入框覆盖  -->
            <Color x:Key="OmniXNavItemSelectedColor">#FF2A1412</Color>
            <Color x:Key="OmniXNavItemSelectedPointerOverColor">#FF3A1B18</Color>
            <Color x:Key="OmniXNavItemSelectedPressedColor">#FF4A2320</Color>
            <Color x:Key="OmniXNavItemPointerOverColor">#FF1D1D22</Color>
            <Color x:Key="OmniXNavItemPressedColor">#FF24242A</Color>
            <Color x:Key="OmniXNavPaneBackgroundColor">#FF121215</Color>
            <Color x:Key="OmniXControlBackgroundColor">#FF1D1D22</Color>
            <Color x:Key="OmniXControlBorderColor">#FF2E2E36</Color>
            <Color x:Key="OmniXControlBorderPointerOverColor">#FF7A2A24</Color>

            <SolidColorBrush x:Key="OmniXAccentBrush" Color="#FFFF4A34" />
            <SolidColorBrush x:Key="OmniXAccentStrongBrush" Color="#FFFF6A55" />
            <SolidColorBrush x:Key="OmniXAccentSoftBrush" Color="#FF2A1412" />
            <SolidColorBrush x:Key="OmniXAccentSoftHoverBrush" Color="#FF3A1B18" />
            <SolidColorBrush x:Key="OmniXAccentSoftPressedBrush" Color="#FF4A2320" />
            <SolidColorBrush x:Key="OmniXPageBackgroundBrush" Color="#FF0B0B0D" />
            <SolidColorBrush x:Key="OmniXSidebarBackgroundBrush" Color="#FF121215" />
            <SolidColorBrush x:Key="OmniXCardBackgroundBrush" Color="#FF16161A" />
            <SolidColorBrush x:Key="OmniXCardAltBackgroundBrush" Color="#FF1D1D22" />
            <SolidColorBrush x:Key="OmniXCardStrokeBrush" Color="#FF26262C" />
            <SolidColorBrush x:Key="OmniXCardStrokeHoverBrush" Color="#FF7A2A24" />
            <SolidColorBrush x:Key="OmniXHeroBackgroundBrush" Color="#FF08080A" />
            <SolidColorBrush x:Key="OmniXTextPrimaryBrush" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="OmniXTextSecondaryBrush" Color="#FF9A9AA4" />
            <SolidColorBrush x:Key="OmniXTextOnHeroBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OmniXTextSecondaryOnHeroBrush" Color="#FFB0B0B8" />
            <SolidColorBrush x:Key="OmniXWarmBrush" Color="#FFFF8A4D" />
            <SolidColorBrush x:Key="OmniXPureWhiteBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OmniXTransparentBrush" Color="Transparent" />

            <LinearGradientBrush x:Key="OmniXSidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FF121215" />
                <GradientStop Offset="1" Color="#FF0B0B0D" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  ===== 通用渐变（红） =====  -->
    <LinearGradientBrush x:Key="OmniXAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFF5B41" />
        <GradientStop Offset="1" Color="#FFB3121D" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OmniXWarmGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFF9A5F" />
        <GradientStop Offset="1" Color="#FFD8461F" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OmniXHeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFB3121D" />
        <GradientStop Offset="0.55" Color="#FFD92B18" />
        <GradientStop Offset="1" Color="#FFFF6A55" />
    </LinearGradientBrush>

    <!--  ========== 圆角 ==========  -->
    <CornerRadius x:Key="OmniXCardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="OmniXControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OmniXPillCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

    <!--  ========== 文本样式 ==========  -->
    <Style x:Key="OmniXPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="OmniXSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextPrimaryBrush}" />
    </Style>

    <Style x:Key="OmniXBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextPrimaryBrush}" />
    </Style>

    <Style x:Key="OmniXCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OmniXStrongCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXAccentStrongBrush}" />
    </Style>

    <!--  ========== 按钮：暗红底红字 ==========  -->
    <Style x:Key="OmniXSoftButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource OmniXAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXAccentStrongBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXControlCornerRadius}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.45"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ========== 按钮：红色渐变主按钮 ==========  -->
    <Style x:Key="OmniXAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource OmniXAccentGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXControlCornerRadius}" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.9"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.78"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.4"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ========== 按钮：橙红渐变 ==========  -->
    <Style
        x:Key="OmniXWarmButtonStyle"
        BasedOn="{ThemeResource OmniXAccentButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource OmniXWarmGradientBrush}" />
    </Style>

    <!--  ========== 按钮：无底透明 ==========  -->
    <Style x:Key="OmniXGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXControlCornerRadius}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.4"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ========== 按钮：危险操作 ==========  -->
    <Style x:Key="OmniXDangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXAccentStrongBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniXCardStrokeHoverBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXControlCornerRadius}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.75"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.4"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ========== 胶囊开关 ==========  -->
    <Style x:Key="OmniXChipToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.4"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentSoftBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OmniXAccentStrongBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ========== 卡片 ==========  -->
    <Style x:Key="OmniXCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource OmniXCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniXCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OmniXCardCornerRadius}" />
    </Style>

    <Style
        x:Key="OmniXAltCardStyle"
        BasedOn="{ThemeResource OmniXCardStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource OmniXCardAltBackgroundBrush}" />
    </Style>

    <Style x:Key="OmniXPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource OmniXAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!--  ========== NavigationView 覆盖（跟随明暗） ==========  -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource OmniXNavItemSelectedColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource OmniXNavItemSelectedPointerOverColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource OmniXNavItemSelectedPressedColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource OmniXNavItemPointerOverColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{ThemeResource OmniXNavItemPressedColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected" Color="{ThemeResource OmniXAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

    <!--  ========== 输入框覆盖（跟随明暗） ==========  -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource OmniXControlBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource OmniXControlBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource OmniXControlBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource OmniXControlBorderColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource OmniXControlBorderPointerOverColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource OmniXAccentColor}" />

    <SolidColorBrush x:Key="OmniXTextBoxBackgroundBrush" Color="{ThemeResource OmniXControlBackgroundColor}" />
    <SolidColorBrush x:Key="OmniXTextBoxBorderBrush" Color="{ThemeResource OmniXControlBorderColor}" />
    <SolidColorBrush x:Key="OmniXComboBoxBackgroundBrush" Color="{ThemeResource OmniXControlBackgroundColor}" />
    <SolidColorBrush x:Key="OmniXComboBoxBorderBrush" Color="{ThemeResource OmniXControlBorderColor}" />

    <Style x:Key="OmniXTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource OmniXTextBoxBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniXTextBoxBorderBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextPrimaryBrush}" />
    </Style>

    <Style x:Key="OmniXComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource OmniXComboBoxBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OmniXComboBoxBorderBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource OmniXTextPrimaryBrush}" />
    </Style>

</ResourceDictionary>
